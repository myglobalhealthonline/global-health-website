{
  "name": "global-health-platform",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "typecheck": "pnpm --filter frontend typecheck && pnpm --filter backend typecheck",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:deploy": "pnpm --filter backend db:deploy",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "railway:login": "railway login",
    "railway:link": "railway link",
    "railway:status": "railway status",
    "railway:logs": "railway logs",
    "railway:connect": "node scripts/connect-railway.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0"
  },
  "pnpm": {
    "overrides": {
      "sanitize-html": "^2.17.4",
      "hono": "4.12.25",
      "@hono/node-server": "1.19.13",
      "postcss": "8.5.10",
      "brace-expansion@5": "5.0.6",
      "esbuild": "0.28.1",
      "ws@7": "7.5.11",
      "form-data": "4.0.6",
      "vite": "8.0.16",
      "@babel/core": "7.29.6",
      "js-yaml": "4.2.0"
    }
  }
}
