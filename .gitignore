# root
/node_modules

# frontend
/frontend/.next
/frontend/node_modules
/frontend/out
/frontend/coverage
/frontend/*.tsbuildinfo
/frontend/.env*

# backend
/backend/node_modules
/backend/.env*

# editor
.vscode

/backend/dist
/backend/.data
/.cursor
/.codex

# dev server logs
*-dev.log
backend-dev*.log
frontend-dev*.log
*.log

# ad-hoc local artifacts — manual API test cookie jars, screenshot
# dumps, preview HTML drops. Never commit credentials by accident.
.tmp-*
**/.tmp-*
preview-*.html
preview-*.html.artifact.json
