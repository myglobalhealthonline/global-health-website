# root
/node_modules
/.railway
**/.env.railway
/.pnpm-store
/.claude/worktrees

# playwright e2e artifacts
/test-results
/playwright-report
/blob-report
/frontend/test-results

# frontend
/frontend/.next
/frontend/node_modules
/frontend/out
/frontend/coverage
/frontend/*.tsbuildinfo
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# backend
/backend/node_modules
/backend/.env
/backend/.env.*
!/backend/.env.example

# editor
.vscode

/backend/dist
/backend/.data
/.cursor
/.codex

# dev server logs
*-dev.log
backend-dev*.log
frontend-dev*.log
*.log

# ad-hoc local artifacts — manual API test cookie jars, screenshot
# dumps, preview HTML drops. Never commit credentials by accident.
.tmp-*
**/.tmp-*
preview-*.html
preview-*.html.artifact.json

# Generated PDF/DOCX QA output and local unzip inspection
/backend/test-output/

# Alex Brush TTF is copied on postinstall (see assets/fonts/README.md)
/backend/assets/fonts/*.ttf

# Large design-reference archives (Figma/Stitch exports). Keep them
# out of the repo — they're 24 MB each and not consumed at build time.
docs/design-fetch*.zip
docs/*.zip
backups/
