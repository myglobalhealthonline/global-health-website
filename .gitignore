# root
/node_modules
/.railway
**/.env.railway
/.pnpm-store
/.claude/worktrees

# scratch (generated PDFs, one-off script output — never committable)
/tmp

# security scanner output (SARIF/JSON reports — regenerate, never commit)
*.sarif

# playwright e2e artifacts
/test-results
/playwright-report
/blob-report
/frontend/test-results
# per-role authenticated sessions (real cookies) — regenerate via auth.setup.ts, never commit
/frontend/tests/e2e/.storage

# frontend
/frontend/.next
/frontend/node_modules
/frontend/out
/frontend/coverage
/frontend/*.tsbuildinfo
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# backend
/backend/node_modules
/backend/.env
/backend/.env.*
!/backend/.env.example
!/backend/.env.test

# doctor credential mailout — roster holds plaintext mailbox passwords,
# out/ holds rendered previews and the send log. Never commit either.
/backend/scripts/data/doctor-credentials.json
/backend/scripts/out/

# editor
.vscode

/backend/dist
/backend/.data
/.cursor
/.codex

# dev server logs
*-dev.log
backend-dev*.log
frontend-dev*.log
*.log

# ad-hoc local artifacts — manual API test cookie jars, screenshot
# dumps, preview HTML drops. Never commit credentials by accident.
.tmp-*
**/.tmp-*
preview-*.html
preview-*.html.artifact.json

# Generated PDF/DOCX QA output and local unzip inspection
/backend/test-output/

# Ad-hoc local diagnostic scripts (keep ops scripts like backfill/purge)
/backend/scripts/test-*.mjs
/backend/scripts/check-generated-doc-storage.mjs
/backend/scripts/list-appointment-generated-docs.mjs
/backend/scripts/test-automation-flow.ts

# Alex Brush is OFL-licensed and vendored in-repo so it always reaches prod
# (build-time network fetch was deliberately removed — see 234ed325). Any
# OTHER .ttf stays ignored; the postinstall sync still allows local overrides.
/backend/assets/fonts/*.ttf
!/backend/assets/fonts/AlexBrush-Regular.ttf

# Large design-reference archives (Figma/Stitch exports). Keep them
# out of the repo — they're large and not consumed at build time.
docs/design-fetch*/
docs/design-fetch*.zip
docs/*.zip
docs/admin-portal-reference.html
backups/

# Session verification screenshots — large PNG dumps, never shipped
docs/plans/portal-implementation/screenshots/
docs/audits/portal/doctor/screenshots/
docs/audits/seo/site-audit-2026-07/screenshots/

# Regenerable audit/QA artifacts. Re-run the tool instead of committing the
# output: Lighthouse dumps, audit and QA screenshot sets.
**/lighthouse/*.json
docs/audits/service-hub-screenshots/
frontend/docs/qa-screenshots/

# Machine-translation drafts pending human review — never committed.
backend/tmp/i18n-drafts/
