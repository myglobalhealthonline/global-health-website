# Test-only environment (audit plan 0.2). Loaded by `pnpm test:db`.
# Points at the isolated docker-compose `postgres-test` service — never at
# dev or live data. test-guard.ts additionally verifies the host/db name.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/global_health_test"
NODE_ENV=test
AUTH_JWT_SECRET="test-only-auth-secret-min-32-characters-long"
JWT_SECRET="test-only-auth-secret-min-32-characters-long"
BLIND_INDEX_KEY="dGVzdC1vbmx5LWJsaW5kLWluZGV4LWtleS0zMmJ5dGVzISE="
PHI_ENCRYPTION_KEY="dGVzdC1vbmx5LXBoaS1lbmNyeXB0aW9uLWtleS0zMmIhIQ=="
BILLING_DRIVER=fake
COMPLIANCE_MODE=relaxed
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
