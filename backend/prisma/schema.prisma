model ConsultationSetting {
  id                     String   @id @default(cuid())
  countryId              String   @unique
  enableGeneral          Boolean  @default(true)
  enableSpecialist       Boolean  @default(true)
  defaultDurationMinutes Int      @default(20)
  leadTimeMinutes        Int      @default(60)
  country                Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/**
 * Per-country footer content. One row per country, edited from
 * /admin/footer (country-scoped). Drives the public site footer
 * when the visitor is inside a country scope (`/[country]/[lang]/*`).
 * Outside that scope the footer falls back to the global defaults
 * baked into SiteFooter so the entry gate + global pages still work.
 *
 * `customColumns` is a JSON array of `{ title, links: [{ label, href, external? }] }`.
 * Care + Clinics columns stay auto-derived (so admins don't have to
 * re-type service links every time a feature toggle changes); custom
 * columns are appended for country-specific copy (e.g. local press,
 * partner clinic addresses, regulator references).
 */
model CountryFooter {
  id             String   @id @default(cuid())
  countryId      String   @unique
  country        Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  /// Brand tagline shown under the logo. Defaults to the global
  /// "Medicine anytime anywhere…" copy when null.
  tagline        String?
  /// Contact block (admin-managed plaintext). Multi-line OK.
  contactAddress String?
  contactEmail   String?
  contactPhone   String?
  /// Optional opening-hours blurb (e.g. "Mon–Fri · 09:00–17:00 IST").
  contactHours   String?
  /// Social URLs surfaced as small icons in the footer ribbon. https://
  /// only — validated at the route layer.
  instagramUrl   String?
  facebookUrl    String?
  linkedinUrl    String?
  twitterUrl     String?
  youtubeUrl     String?
  /// Custom link columns. Array of
  /// `{ title: string; links: Array<{ label: string; href: string; external?: boolean }> }`.
  /// Defaults to `[]`. Admin reorders by re-saving; UI is a simple
  /// add/remove form, not drag-to-reorder.
  customColumns  Json     @default("[]")
  /// Optional copyright suffix override (replaces "© Global Health"
  /// when set, e.g. "© Global Health Romania SRL"). The "Medicine
  /// anytime anywhere" tagline + year prefix stay the same.
  copyrightLine  String?
  /// Soft-disable so admin can prep a footer without surfacing it yet.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BookingSetting {
  id                 String   @id @default(cuid())
  countryId          String   @unique
  bookingEnabled     Boolean  @default(true)
  requirePhone       Boolean  @default(true)
  requireDateOfBirth Boolean  @default(true)
  /// When true, the country's booking form requires the patient to enter
  /// a national ID at booking time. UI label resolves per-country (NIF,
  /// PPS, CPF, …). Default off so existing markets opt-in.
  requireNationalId  Boolean  @default(false)
  /// When true, the booking form requires structured address fields
  /// (line1, city, postal). Defaults true for RX-eligible markets so we
  /// can ship prescriptions; pure-telemedicine markets can disable.
  requireAddress     Boolean  @default(true)
  /// When true, doctor self-selected services require admin approval before booking.
  doctorServiceSelfSelectApproval Boolean @default(true)
  timezone           String   @default("UTC")
  country            Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum VerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AppointmentStatus {
  REQUEST_RECEIVED
  UNDER_REVIEW
  CONTACTED
  CANCELLED
  COMPLETED
}

model Appointment {
  id                        String                    @id @default(cuid())
  userId                    String?
  countryCode               String
  consultationType          String
  /// BCP-47 language code chosen by patient at booking time (e.g. "en", "pt", "fr").
  /// Null for legacy bookings made before language selection was introduced.
  consultationLanguageCode  String?
  /// Why this doctor was auto-assigned by the same-day GP quick-book flow
  /// (e.g. "PRIORITY_24H", "ROTATION", "ONLY_AVAILABLE"). Null for manual /
  /// doctor-first bookings where the patient picked the clinician. Populated
  /// at mint from the GpAssignmentLog row keyed by timeSlotId.
  assignmentReason          String?
  fullName                  String
  email                     String
  phone                     String?
  /// Optional patient date of birth — captured when the country's
  /// BookingSetting.requireDateOfBirth is on. Stored as a Date so we
  /// can compute age + filter by ranges later.
  dateOfBirth               DateTime?
  notes                     String?
  consentAccepted           Boolean
  status                    AppointmentStatus         @default(REQUEST_RECEIVED)
  // Optional link to the catalogue Service that was booked. Populated when
  // the booking form passes ?service=<slug>; null for free-text bookings.
  serviceId                 String?
  service                   Service?                  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Optional HealthTest the patient picked at booking. Set when the
  /// booking form arrives with `?service=<healthTestSlug>` and the slug
  /// matches a HealthTest row. Symmetric with `serviceId` above.
  healthTestId              String?
  healthTest                HealthTest?               @relation(fields: [healthTestId], references: [id], onDelete: SetNull)
  /// Doctor assigned to take the call. Set by admin on the schedule form;
  /// the doctor's portal at /doctor scopes queries to `doctorId = self`.
  /// Optional because not every appointment has a doctor yet.
  doctorId                  String?
  doctor                    Doctor?                   @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  /// Concrete time slot the patient picked at booking. Populated when
  /// the booking form posts with `timeSlotId`; the booking handler
  /// atomically claims the slot (UPDATE…WHERE status='OPEN') so two
  /// patients can never grab the same one. Null = legacy flow (admin
  /// schedules the call manually later).
  timeSlotId                String?                   @unique
  timeSlot                  DoctorTimeSlot?           @relation("AppointmentSlot", fields: [timeSlotId], references: [id], onDelete: SetNull)
  /// One Consultation row per Appointment — created on first save from
  /// the doctor portal, locked when signed.
  consultation              Consultation?
  /// Per-appointment lab / imaging / exam results the doctor logs.
  examResults               ExamResult[]
  /// Doctor ↔ admin notes for this appointment (NOT patient-visible —
  /// patient chat lives on `messages`).
  internalMessages          InternalMessage[]
  /// Form submissions tied to this appointment (intake, pre-consult,
  /// post-consult surveys).
  formSubmissions           FormSubmission[]
  /// First-party documents the doctor attaches to this appointment
  /// (PDFs, scans, photos). Stored in S3 under a doctor-scoped key
  /// prefix; admin doesn't auto-see them.
  documents                 AppointmentDocument[]
  /// Self-reference: when this appointment is a follow-up, points at
  /// the appointment the patient is following up FROM. Lets the
  /// workspace render a "Follow-up of …" badge and the patient
  /// history a continuous chain.
  followUpFromAppointmentId String?
  followUpFrom              Appointment?              @relation("AppointmentFollowUp", fields: [followUpFromAppointmentId], references: [id], onDelete: SetNull)
  followUps                 Appointment[]             @relation("AppointmentFollowUp")
  /// ONLINE (telemedicine, default) or IN_PERSON (in-clinic). Empty
  /// `meetingUrl` is the operational signal for IN_PERSON today.
  consultationMode          ConsultationMode          @default(ONLINE)
  // Payment lifecycle. UNPAID = free or pending-Stripe.
  paymentStatus             PaymentStatus             @default(UNPAID)
  // Stripe identifiers. Null until a Checkout Session is created.
  stripeSessionId           String?                   @unique
  stripePaymentIntentId     String?                   @unique
  amountCents               Int?
  currencyCode              String?
  paidAt                    DateTime?
  // Scheduled call time + Google Meet (or any video) URL. Admin sets these
  // once a slot has been agreed; patient sees them on /account/bookings and
  // receives a SendGrid email with the link.
  scheduledAt               DateTime?
  meetingUrl                String?
  // Reminder job marks this once it has emailed the patient ~24h before
  // scheduledAt, so re-runs don't double-send. Null means "not sent yet".
  reminderSentAt            DateTime?
  // Same idea but for the in-portal "you have an appointment tomorrow"
  // notification fan-out to the assigned doctor. Tracked separately so
  // the patient-email path and the doctor-notification path can diverge.
  doctorReminderSentAt      DateTime?
  user                      User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments                  Payment[]
  messages                  Message[]
  /// Relational join to the Order(s) this appointment was minted for.
  /// See Order.orderAppointments.
  orderAppointments         OrderAppointment[]
  /// Patient ↔ doctor consultation chat. Separate thread from the
  /// patient ↔ admin `messages` above. Open by default; auto-locks
  /// 24h after `consultationCompletedAt` unless doctor re-opens.
  chatMessages              ConsultationMessage[]
  /// Corporate plan back-relations: set when this appointment is a
  /// corporate employee's onboarding pre-assessment, or fulfils an
  /// Illness-Benefit / Fit-for-Work CorporateServiceRequest.
  corporateEmployeePreAssessment CorporateEmployee?
  corporateServiceRequest        CorporateServiceRequest?
  /// Set when the appointment moves to COMPLETED status. Used to
  /// compute the 24h chat-window expiry on the consultation chat.
  consultationCompletedAt   DateTime?
  /// Doctor can re-open the consultation chat after the 24h window.
  chatReopenedByDoctor      Boolean                   @default(false)
  /// Legacy doctor-dashboard finalize workflow.
  finalized                 Boolean                   @default(false)
  notesUploaded             Boolean                   @default(false)
  filesUploaded             Boolean                   @default(false)
  manualEntry               Boolean                   @default(false)
  pharmacy                  String?
  symptoms                  String?
  formResponses             Json?
  generatedDocuments        GeneratedDocument[]
  medicalNotes              MedicalNote[]
  brazilConsentSubmissions  BrazilConsentSubmission[]
  reviewInvites             ReviewInvite[]
  automationRuns            AutomationRun[]
  /// For IN_PERSON appointments — soft FK to a known Clinic OR a free-text
  /// override in `locationAddress`. Exactly one of (clinicId, locationAddress)
  /// is required when consultationMode = IN_PERSON; backend rejects requests
  /// with both or neither.
  clinicId                  String?
  clinic                    Clinic?                   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  locationAddress           String?
  /// Patient timezone captured at booking time (IANA TZ string from
  /// `Intl.DateTimeFormat().resolvedOptions().timeZone`). Used to render
  /// `scheduledAt` in the patient's local time on emails + portals; doctor
  /// portal shows both doctor-local and patient-local side-by-side.
  /// Null on legacy appointments — render uses browser TZ as fallback.
  patientTimezone           String?
  /// Patient address snapshot — captured on the booking form when
  /// `BookingSetting.requireAddress` is on (RX-eligible markets default
  /// true). Snapshotted onto the appointment so changes to PatientProfile
  /// don't rewrite the historical booking record.
  addressLine1              String?
  addressLine2              String?
  addressCity               String?
  addressPostalCode         String?
  addressCountryCode        String?
  /// GDPR consent — two independent flags captured at booking. The first
  /// is required to submit (sharing data with the treating clinic/doctor);
  /// the second is independently required (platform processing for service
  /// improvement + communications). Stored separately so withdrawal of
  /// platform consent doesn't invalidate the clinical record.
  gdprConsentClinic         Boolean                   @default(false)
  gdprConsentPlatform       Boolean                   @default(false)
  gdprConsentedAt           DateTime?
  /// WhatsApp appointment updates — default ON; patient opts OUT at booking.
  whatsappConsent           Boolean                   @default(true)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([clinicId])
  @@index([userId])
  @@index([email])
  @@index([doctorId])
  @@index([doctorId, email])
  @@index([status, createdAt])
  @@index([doctorId, scheduledAt])
  @@index([countryCode, status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([userId, status, createdAt])
}

/// Persistent patient chart keyed by email (one row per patient identity).
model PatientProfile {
  id                 String       @id @default(cuid())
  email              String       @unique
  userId             String?      @unique
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName           String?
  phone              String?
  dateOfBirth        DateTime?
  weightKg           Float?
  heightM            Float?
  bmi                Float?
  bloodType          String?
  allergies          String[]     @default([])
  chronicDiseases    String[]     @default([])
  familyHistory      String[]     @default([])
  socialHabits       String[]     @default([])
  surgeries          String[]     @default([])
  /// Patient's regular/ongoing medications. One entry per drug (e.g.
  /// "Metformin 850mg 2x/day"). Distinct from prescriptions issued per
  /// consultation.
  usualMedication    String[]     @default([])
  /// Latest recorded arterial (blood) pressure, mmHg. Systolic over
  /// diastolic. Null when never measured.
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  medicalNotes       Json         @default("[]")
  /// National identity card / NIC / DNI / RG / CC — single field, label
  /// resolved per country in the UI layer (i18n).
  nationalIdNumber   String?
  /// Tax / health-system ID (NIF in PT, PPS in IE, CPF in BR). Used on
  /// prescription PDFs + invoices.
  taxIdNumber        String?
  /// Passport number — orthogonal to local IDs; international patients
  /// often have both.
  passportNumber     String?
  /// Persistent address. `Order.ship*` stays per-checkout so patients
  /// can ship to a different address; this is the canonical "home".
  addressLine1       String?
  addressLine2       String?
  addressCity        String?
  addressPostalCode  String?
  addressCountryCode String?
  /// Pharmacy the patient most often uses. Prefills
  /// `Appointment.pharmacy` so doctor doesn't re-enter each visit.
  preferredPharmacy  String?
  /// Doctor-only clinical flag shown as a red banner at the top of the
  /// patient chart (e.g. "Severe penicillin allergy"). Never visible to
  /// the patient. Writes audit-logged via PATIENT_ALERT_UPDATED.
  statusAlert        String?
  /// Doctor-only operational flag shown as a yellow banner (e.g.
  /// "Schedule mornings only"). Same visibility + audit rules as
  /// `statusAlert`.
  clinicAlert        String?
  /// Optional link to a brand-side PricingPlan the patient is enrolled
  /// in. Drives plan-aware behaviour on /account/profile and (later)
  /// invoice copy. Null = pay-as-you-go.
  pricingPlanId               String?
  pricingPlan                 PricingPlan?                  @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  /// Unique patient identifier across all records. Format: GH-YYYY-000001.
  /// Issued atomically at registration. Never reused. Never editable by patient or admin.
  globalHealthNumber          String?                       @unique
  /// Insurance details (optional — never blocks booking or registration).
  insuranceProviderName       String?
  /// AES-256-GCM encrypted (same phi:v1: envelope as nationalIdNumber).
  insurancePolicyNumber       String?
  /// S3 storageKey for the uploaded insurance card/document. Never a public URL.
  insuranceDocumentKey        String?
  insuranceDocumentStatus     VerificationStatus            @default(NOT_VERIFIED)
  insuranceAdminNotes         String?
  /// ID verification fields — admin-managed; patient uploads doc, admin sets status.
  idVerificationStatus        VerificationStatus            @default(NOT_VERIFIED)
  idDocumentKey               String?
  idDocumentBackKey           String?
  idDocumentType              String?
  idDocumentNumber            String?
  idDocumentIssuingCountry    String?
  idDocumentExpiryDate        DateTime?
  idVerificationAdminNotes    String?
  idVerificationReviewedBy    String?
  idVerificationReviewedAt    DateTime?
  /// Phone / email verification. Email status mirrors User.emailVerifiedAt.
  phoneVerificationStatus     VerificationStatus            @default(NOT_VERIFIED)
  phoneVerifiedAt             DateTime?
  emailVerificationStatus     VerificationStatus            @default(NOT_VERIFIED)
  emailVerifiedAt             DateTime?
  /// Stripe customer — set when first subscription or payment method is attached.
  stripeCustomerId            String?                       @unique
  /// Relations to new patient-linked tables.
  nationalityDocuments        PatientNationalityDocument[]
  medicalDocuments            MedicalDocument[]
  consents                    PatientConsent[]
  medicalAccessLogs           MedicalAccessLog[]
  /// Country folder this patient's medical record belongs to.
  originCountryCode           String?
  countryFolderCode           String?
  currentCountryCode          String?
  /// Latest medical data access consent level.
  /// Values: DIRECT_ONLY | COUNTRY_CLINIC | GLOBAL_NETWORK
  medicalAccessConsentLevel   String?
  /// HMAC blind-index columns for dedup matching on encrypted fields.
  /// Never decrypt these; only compare hashes for collision detection.
  emailHash                   String?
  phoneHash                   String?
  nameDobHash                 String?
  /// Automated ID verification provider and result.
  idVerificationProvider      String?
  idVerificationProviderRef   String?
  idVerificationConfidence    Float?
  idVerificationRawResult     Json?
  idVerificationWebhookAt     DateTime?
  /// One-patient-one-file: merge state.
  isMerged                    Boolean                       @default(false)
  mergedIntoPatientId         String?
  mergedAt                    DateTime?
  mergedByAdminId             String?
  anonymizedAt                DateTime?
  /// Relations added in Phase 2.
  mergeLogs                   PatientMergeLog[]             @relation("PatientMergeSource")
  contactChangeLogs           PatientContactChangeLog[]
  medicalAccessRequests       MedicalAccessRequest[]
  deletionRequests            DataDeletionRequest[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([pricingPlanId])
  @@index([globalHealthNumber])
}

model GeneratedDocument {
  id            String                @id @default(cuid())
  appointmentId String
  doctorId      String
  patientEmail  String
  documentType  GeneratedDocumentType
  fileName      String
  storageKey    String
  sentToPatient Boolean               @default(false)
  metadata      Json?
  /// Per-appointment sequential stamp; only set for EXAMS_PRESCRIPTION.
  prescriptionNumber   Int?
  /// Per-prescription patient-upload link (v3 token). EXAMS_PRESCRIPTION only.
  uploadToken          String?
  uploadTokenExpiresAt DateTime?
  /// Unique public ID for certificate verification. CUSTOM_CERTIFICATE only.
  certificateId        String?   @unique
  appointment   Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor                @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([appointmentId, documentType])
  @@index([appointmentId, sentToPatient])
}

/// Free-text clinical note per appointment (not a PDF; no review/send).
model MedicalNote {
  id                String      @id @default(cuid())
  appointmentId     String
  patientEmail      String
  content           String
  consultationType  String?
  createdByDoctorId String
  createdByName     String
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdByDoctor   Doctor      @relation("MedicalNoteAuthor", fields: [createdByDoctorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt         DateTime    @default(now())

  @@index([patientEmail, createdAt])
  @@index([appointmentId])
}

model BrazilConsentSubmission {
  id              String                     @id @default(cuid())
  appointmentId   String
  fullName        String?
  dob             String?
  address         String?
  email           String?
  phone           String?
  pharmacy        String?
  message         String                     @default("")
  gdprConsent     Boolean                    @default(true)
  stripeSessionId String?
  paymentStatus   BrazilConsentPaymentStatus @default(PENDING)
  paidAt          DateTime?
  appointment     Appointment                @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([appointmentId])
}

model ReviewInvite {
  id                    String       @id @default(cuid())
  /// SHA-256 hex digest of the bearer token — never store the raw token
  /// (S-009). The raw token only ever exists in the URL emailed/WhatsApp'd
  /// to the patient.
  tokenHash             String       @unique
  appointmentId         String?
  orderNumber           String?
  customerName          String?
  serviceName           String?
  doctorName            String?
  contactEmail          String?
  contactPhone          String?
  localeCode            String?
  expiresAt             DateTime
  submittedAt           DateTime?
  overallSatisfaction   Int?
  doctorProfessionalism Int?
  communicationClarity  Int?
  timelinessOfService   Int?
  valueForMoney         Int?
  likeliness            Int?
  bookingExperience     Int?
  appointment           Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())

  @@index([appointmentId])
}

/// Lightweight chat thread for the patient ↔ admin pre-consult conversation.
/// Newsletter signups from the footer form. Patient supplies email + the
/// country/locale context they were on; admin can export the list.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  countryCode    String?
  locale         String?
  source         String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

/// One thread per Appointment. Polling-based (no WebSocket layer); when
/// volume justifies it we can swap to Pusher / Soketi without UI changes.
enum MessageAuthorRole {
  PATIENT
  ADMIN
}

/// Author side for the patient ↔ doctor consultation chat. Separate from
/// `MessageAuthorRole` (patient ↔ admin) so queries never mix the threads.
enum ChatAuthorRole {
  PATIENT
  DOCTOR
}

model Message {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorRole    MessageAuthorRole
  authorUserId  String? // null for the patient guest-booking path
  body          String
  readByPatient Boolean           @default(false)
  readByAdmin   Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([appointmentId, createdAt])
}

/// Shopping cart for orderable items (Health Tests + Online Prescriptions)
/// and v2 consultations. Lives in DB for both guests (cookieToken) and
/// logged-in patients (userId). On login, the cookie cart is merged
/// into the user cart and the cookie one is deleted. One country per
/// cart — adding from another country must clear the cart first.
enum CartItemKind {
  HEALTH_TEST
  PRESCRIPTION_SERVICE
  GENERAL_CONSULTATION
  SPECIALIST_CONSULTATION
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PrePaymentFlow {
  WITHIN_48H
  OUTSIDE_48H
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  CANCELLED
}

model Cart {
  id                   String     @id @default(cuid())
  userId               String?    @unique
  cookieToken          String?    @unique
  countryCode          String
  currencyCode         String
  items                CartItem[]
  /// Stamped when the abandoned-cart reminder has been emailed.
  /// Prevents re-sending. Cleared on checkout / cart-clear.
  abandonedEmailSentAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([updatedAt, abandonedEmailSentAt])
}

/// Per-consultation-line benefit choice (§ appointment-claim). PAY_NORMAL is the
/// safe default: a line never consumes a credit unless the user explicitly chose
/// USE_PLAN_CREDIT. USE_PLAN_DISCOUNT applies an eligible fixed/percent discount
/// only, never a credit.
enum BenefitSelection {
  PAY_NORMAL
  USE_PLAN_CREDIT
  USE_PLAN_DISCOUNT
}

model CartItem {
  id                       String       @id @default(cuid())
  cartId                   String
  cart                     Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  kind                     CartItemKind
  healthTestId             String?
  serviceId                String?
  /// Snapshot of the product name at the time the item was added.
  name                     String
  /// Snapshot price in cents — checkout uses this, not the live row, so
  /// a price change between add-to-cart and pay doesn't surprise the user.
  unitPriceCents           Int
  /// Snapshot of the per-unit shipping fee at add-to-cart time. 0 for
  /// online consultations (no physical delivery). Cart total adds
  /// `shippingCents * quantity` across all items.
  shippingCents            Int          @default(0)
  quantity                 Int          @default(1)
  /// Consultation items: which slot the patient claimed.
  timeSlotId               String?      @unique
  doctorId                 String?
  /// Consultation-only reservation deadline. Set to now+10min when a
  /// consultation slot is added. Sweep on every cart op releases
  /// expired items (slot HELD→OPEN + cart item deleted) so the same
  /// time becomes bookable for another patient.
  /// Null for product items (no slot to hold).
  heldUntil                DateTime?
  /// Patient intake snapshot — collected on the consult page before
  /// add-to-cart so the cart line carries everything the webhook needs
  /// to mint the Appointment. Nullable for product items (HEALTH_TEST,
  /// PRESCRIPTION_SERVICE never take a patient form). For consultation
  /// kinds the cart route requires them on POST /api/cart/items.
  patientFullName          String?
  patientEmail             String?
  patientPhone             String?
  patientDateOfBirth       DateTime?
  patientNotes             String?
  patientConsentAcceptedAt DateTime?
  /// `true` when the visitor toggled "Booking for someone else" on the
  /// consult form. We still keep account DOB intact in that case.
  bookingForOther          Boolean      @default(false)
  /// Per-line subscription benefit choice. Default PAY_NORMAL never
  /// consumes a credit; the pricing engine only reserves a credit when the
  /// user explicitly picks USE_PLAN_CREDIT and the line is eligible.
  benefitSelection         BenefitSelection @default(PAY_NORMAL)
  /// Approved dependent this consultation is booked for (Premium family
  /// usage). Null = booking for the account holder. The FK proves the
  /// member is a real row; ownership (primaryUserId == cart user) is
  /// re-checked server-side at add-to-cart, preview, and checkout.
  familyMemberId           String?
  familyMember             FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  /// Patient identity + address + GDPR snapshot captured at add-to-cart
  /// time so the post-payment webhook can mint the Appointment without
  /// asking again at checkout. Mirrors the new Appointment columns added
  /// in the same migration. Nullable for product items.
  patientNationalIdNumber  String?
  patientTimezone          String?
  patientAddressLine1      String?
  patientAddressLine2      String?
  patientAddressCity       String?
  patientAddressPostalCode String?
  patientAddressCountryCode String?
  patientGdprConsentClinic   Boolean   @default(false)
  patientGdprConsentPlatform Boolean   @default(false)
  patientGdprConsentedAt     DateTime?
  /// WhatsApp appointment updates — default ON; patient opts OUT at booking.
  patientWhatsappConsent     Boolean   @default(true)
  createdAt                DateTime     @default(now())

  @@index([heldUntil])
}

/// Multi-item order. One Stripe Checkout session per Order.
/// Status flow: PENDING → PAID (via webhook) → FULFILLED (admin) → REFUNDED.
model Order {
  id                    String      @id @default(cuid())
  /// Human-facing sequential order reference (e.g. ORD-000001).
  orderNumber           String?     @unique
  userId                String?
  email                 String
  fullName              String
  phone                 String?
  countryCode           String
  currencyCode          String
  subtotalCents         Int
  shippingCents         Int         @default(0)
  totalCents            Int
  status                OrderStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(UNPAID)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?     @unique
  stripeInvoiceId       String?     @unique
  /// InvoiceExpress InvoiceReceipt id issued for a paid Portugal order (direct
  /// REST issuance). Null for non-PT / not-yet-issued. Presence = idempotency
  /// guard so webhook redelivery + sync fallback never double-issue.
  invoiceExpressId      String?     @unique
  paidAt                DateTime?
  /// Shipping address — collected at checkout for product orders.
  shipName              String?
  shipLine1             String?
  shipLine2             String?
  shipCity              String?
  shipPostalCode        String?
  shipCountryCode       String?
  /// Appointment ids minted for consultation items in this order (v2).
  /// @deprecated no FK integrity — an appointment id here can survive
  /// deletion of the appointment it names, or drift out of sync. Dual-
  /// written alongside `orderAppointments` below (code review 2026-07-05,
  /// Suggestion 8); prefer the relation for new code.
  appointmentIds        String[]
  /// Relational replacement for `appointmentIds` — real FK integrity, no
  /// orphaned ids possible. See the field's deprecation note above.
  orderAppointments     OrderAppointment[]
  /// Google Meet link generated by admin for online consultation orders.
  meetingUrl            String?
  /// Pre-payment automation: payment deadline and reminder progress.
  paymentDueAt              DateTime?
  prePaymentFlow            PrePaymentFlow?
  prePaymentReminderStage   Int                @default(0)
  prePaymentFlowStartedAt   DateTime?
  /// Post-payment automation: payment confirmation, meeting link, reminders.
  postPaymentStage          Int                @default(0)
  postPaymentFlowStartedAt  DateTime?
  /// Manual-booking patient portal access — reused across all automation messages.
  patientPortalSetPasswordUrl String?
  patientPortalTempPassword   String?
  patientPortalTempPasswordSent Boolean          @default(false)
  automationRuns            AutomationRun[]
  items                 OrderItem[]
  /// Wellness-credit health-kit redemption fulfilled by this order, if any
  /// (a €0 kit line + postage in shippingCents — §11).
  healthTestRedemption  HealthTestRedemption?
  /// Fiscal documents for this order (empty for Portugal / pre-invoice orders).
  /// Normally one invoice/receipt, plus a CREDIT_NOTE if the order was refunded.
  invoices              Invoice[]
  /// Stripe Checkout URL cached for admin copy-paste. Refreshed by resolveOrderPaymentUrl.
  stripeCheckoutUrl     String?
  /// Shipment tracking — admin-entered for physical orders (health test kits,
  /// prescription delivery). All nullable; the patient order page shows a
  /// "Track shipment" section only when trackingNumber is set.
  trackingNumber        String?
  trackingCarrier       String?
  trackingUrl           String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentDueAt, prePaymentFlow, prePaymentReminderStage])
  @@index([postPaymentStage, paymentStatus])
  @@index([appointmentIds], type: Gin, map: "Order_appointmentIds_gin_idx")
}

/// Relational join between Order and Appointment (code review 2026-07-05,
/// Suggestion 8) — replaces the denormalized `Order.appointmentIds` array,
/// which has no FK integrity and can hold an id after the appointment it
/// names is gone. Dual-written alongside the array during the transition;
/// see the deprecation note on `Order.appointmentIds`.
model OrderAppointment {
  id            String      @id @default(cuid())
  orderId       String
  appointmentId String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([orderId, appointmentId])
  @@index([appointmentId])
}

/// Log of every automation step (WhatsApp, email, cron) for admin visibility.
model AutomationRun {
  id            String              @id @default(cuid())
  automationKey String
  orderId       String?
  order         Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  status        AutomationRunStatus @default(PENDING)
  channel       String?
  recipient     String?
  summary       String?
  error         String?
  metadata      Json?
  scheduledFor  DateTime?
  executedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([automationKey, createdAt(sort: Desc)])
  @@index([orderId, createdAt(sort: Desc)])
}

model OrderItem {
  id                       String       @id @default(cuid())
  orderId                  String
  order                    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                     CartItemKind
  healthTestId             String?
  serviceId                String?
  /// Snapshot — independent of source row deletion.
  name                     String
  unitPriceCents           Int
  quantity                 Int
  lineTotalCents           Int
  /// Consultation-only refs (v2).
  timeSlotId               String?
  doctorId                 String?
  appointmentId            String?
  /// Patient intake snapshot — copied from CartItem at checkout time so
  /// the payment webhook mints the Appointment with the right name,
  /// email, phone, DOB, notes even when the booking is for someone
  /// other than the payer. Nullable for product items.
  patientFullName          String?
  patientEmail             String?
  patientPhone             String?
  patientDateOfBirth       DateTime?
  patientNotes             String?
  patientConsentAcceptedAt DateTime?
  bookingForOther          Boolean      @default(false)
  /// Per-line benefit choice copied from the CartItem at checkout — kept
  /// for audit (which lines used a credit/discount vs paid normally).
  benefitSelection         BenefitSelection @default(PAY_NORMAL)
  /// Corporate plan audit trail — set when the corporate benefit engine
  /// discounted this line at checkout (unitPriceCents is ALREADY the
  /// discounted price; this records how much was taken off and for
  /// which company, for reconciliation).
  corporateDiscountCents   Int?
  corporateCompanyId       String?
  /// Approved dependent this order line was booked for (Premium family
  /// usage). Copied from the CartItem at checkout for audit + portal.
  familyMemberId           String?
  familyMember             FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  /// Mirror of the CartItem snapshot columns added in the booking-fields
  /// migration. The payment webhook reads these to mint the Appointment
  /// with the right timezone, address, ID number, and dual GDPR consent
  /// even when the booking is for someone other than the payer.
  patientNationalIdNumber  String?
  patientTimezone          String?
  patientAddressLine1      String?
  patientAddressLine2      String?
  patientAddressCity       String?
  patientAddressPostalCode String?
  patientAddressCountryCode String?
  patientGdprConsentClinic   Boolean   @default(false)
  patientGdprConsentPlatform Boolean   @default(false)
  patientGdprConsentedAt     DateTime?
  /// WhatsApp appointment updates — default ON; patient opts OUT at booking.
  patientWhatsappConsent     Boolean   @default(true)

  @@index([orderId])
}

/// Append-only ledger of Stripe events per Appointment. One row per webhook
/// `payment_intent.{created,succeeded,failed}` we accept. Makes the audit
/// trail explicit even when an appointment ends up REFUNDED later.
model Payment {
  id                    String        @id @default(cuid())
  appointmentId         String
  // Restrict, not Cascade: a Payment row is a financial/audit record (refund
  // disputes, accounting, PHI audit trail) and must survive deletion of the
  // Appointment it's attached to. Every other Appointment relation is
  // SetNull; Payment was the one outlier (code review 2026-07-05, SF6).
  appointment           Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  stripeEventId         String        @unique
  stripeSessionId       String?
  stripePaymentIntentId String?
  status                PaymentStatus
  amountCents           Int
  currencyCode          String
  rawEventType          String
  rawPayload            Json
  createdAt             DateTime      @default(now())

  @@index([appointmentId])
}

/// Idempotency ledger for Stripe webhook events that don't write a Payment
/// row (e.g. cart-order checkouts, which have no appointmentId). One row per
/// processed event id; the webhook handler dedupes against it on retry.
model ProcessedWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  createdAt     DateTime @default(now())
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  phone                   String?
  /// Canonical patient date of birth. Lives here (not on Appointment)
  /// so signed-in users only enter it once and every checkout /
  /// fallback intake can prefill it. Nullable for backward-compat
  /// with existing accounts. Doctors/admins don't need it set.
  dateOfBirth             DateTime?
  role                    UserRole                 @default(PATIENT)
  emailVerifiedAt         DateTime?
  isActive                Boolean                  @default(true)
  /// True when this account was created with a temporary password
  /// (e.g. admin-initiated manual booking). Login flow force-redirects
  /// to /account/change-password on first successful sign-in; the
  /// change-password endpoint clears the flag back to false.
  mustChangePassword      Boolean                  @default(false)
  /// Set when role=DOCTOR — links the login account to the Doctor
  /// profile that shows on the public site. Admin assigns this from
  /// the doctor edit page. One-to-one.
  doctorId                String?                  @unique
  doctorProfile           Doctor?                  @relation("DoctorUserLink", fields: [doctorId], references: [id], onDelete: SetNull)
  appointments            Appointment[]
  resetTokens             PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  /// Internal (doctor ↔ admin) messages this user authored. Patient
  /// messages live on `Message.authorUserId` which is unrelated to
  /// this relation name.
  internalMessages        InternalMessage[]        @relation("InternalMessageAuthor")
  /// Doctor portal notifications routed to this user.
  notifications           Notification[]
  /// Share links this user created (signed consultation URLs etc.).
  shareLinks              ShareLink[]              @relation("ShareLinkAuthor")
  /// Patient-side: form submissions associated to this user (when the
  /// patient is signed-in at submit time). Guest submissions don't
  /// reference a user.
  formSubmissions         FormSubmission[]
  /// Audit-log rows authored by this user (consult signs, message
  /// posts, share-link mints…). actor=null entries are SYSTEM events.
  auditEvents             AuditLog[]
  patientProfile          PatientProfile?
  /// Subscriptions owned by this user (§20). One active at a time —
  /// enforced by a raw-SQL partial unique on userId for active statuses.
  subscriptions           UserSubscription[]
  /// Admin country scope — only relevant when role=LOCAL_ADMIN.
  adminScope              AdminScope?
  /// Country codes this LOCAL_ADMIN can access. Empty = no access (should not happen).
  allowedCountryFolders   String[]                 @default([])
  /// TOTP / 2FA. Secret is stored AES-256-GCM encrypted (same phi:v1: envelope).
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  twoFactorBackupCodes    String[]                 @default([])
  twoFactorVerifiedAt     DateTime?
  twoFactorEnabledAt      DateTime?
  medicalAccessRequests   MedicalAccessRequest[]   @relation("MedicalAccessRequestReviewer")
  /// Bumped on "sign out of all devices". Embedded in every JWT at login;
  /// verify rejects a token whose tokenVersion doesn't match this value, so
  /// every previously-issued token (all devices) is invalidated at once.
  tokenVersion            Int                      @default(0)
  /// GDPR soft-delete grace period. Set to now()+30d when the patient
  /// requests deletion; account stays fully functional until then and the
  /// request can be cancelled by clearing this field. Login treats a past
  /// deletionScheduledAt as inactive.
  /// ponytail: needs a purge cron reading deletionScheduledAt < now to hard-
  /// delete/scrub — no cron runner exists yet that's a good fit (the only
  /// one in backend/src/lib/internal-scheduler.ts is subscription-specific
  /// and lives in a module this feature doesn't belong to). Wire a new tick
  /// into that scheduler when the purge is actually built.
  deletionScheduledAt     DateTime?
  /// Corporate plan (private B2B) back-relations. A CORPORATE_ADMIN user
  /// administers exactly one company; a PATIENT user may be linked as an
  /// employee and/or beneficiary membership row after invite accept.
  corporateCompanyAdmin   CorporateCompany?        @relation("CorporateCompanyAdmin")
  corporateEmployees      CorporateEmployee[]
  corporateBeneficiaries  CorporateBeneficiary[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /**
   * Distinguishes a doctor-invite token (7-day TTL, on-consume auto
   * sign-in) from a regular forgot-password token (1-hour TTL, no
   * auto sign-in). The consume path validates the caller's intent
   * against this flag so a stolen reset token can't be replayed with
   * `?invite=1` to grant a session.
   */
  isInvite  Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model BlogPost {
  id                  String        @id @default(cuid())
  countryId           String?
  slug                String
  title               String
  excerpt             String?
  body                String
  status              PublishStatus @default(DRAFT)
  locale              LocaleCode
  category            String?
  authorDisplayName   String?
  reviewerDisplayName String?
  /// Optional link to a real Doctor as the named author / clinical reviewer.
  /// When set, the public Article schema emits a Physician author/reviewedBy
  /// block with the doctor's council registration + recognisedBy authority,
  /// which is what earns AI-search citation authority. Free-text display
  /// names above remain the fallback when no doctor is linked.
  authorDoctorId      String?
  reviewerDoctorId    String?
  coverAssetId        String?
  seoTitle            String?
  seoDescription      String?
  publishedAt         DateTime?
  lastReviewedAt      DateTime?
  editorialChecklist  Json?
  isActive            Boolean       @default(true)
  country             Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  authorDoctor        Doctor?           @relation("BlogAuthorDoctor", fields: [authorDoctorId], references: [id], onDelete: SetNull)
  reviewerDoctor      Doctor?           @relation("BlogReviewerDoctor", fields: [reviewerDoctorId], references: [id], onDelete: SetNull)
  coverAsset          Asset?            @relation("BlogPostCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  translations        BlogTranslation[]
  countries           BlogPostCountry[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([slug, locale, countryId])
  @@index([countryId, status, locale])
}

model BlogTranslation {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale    String
  title     String
  slug      String
  excerpt   String?
  content   String?
  seoTitle  String?
  seoDesc   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, locale])
  @@index([postId])
}

model BlogPostCountry {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, countryId])
  @@index([postId])
  @@index([countryId])
}

model Faq {
  id           String     @id @default(cuid())
  countryId    String?
  question     String
  answer       String
  locale       LocaleCode
  category     String?
  placementKey String?
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  country      Country?   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([countryId, locale, isActive])
}

model ContentPage {
  id                 String        @id @default(cuid())
  countryId          String
  pageKey            PageKey
  locale             LocaleCode
  status             PublishStatus @default(DRAFT)
  title              String
  body               String
  heroTitle          String?
  heroSubtitle       String?
  heroImageAssetId   String?
  heroImagePath      String?
  ctaLabel           String?
  ctaHref            String?
  ogImageAssetId     String?
  ogImagePath        String?
  seoTitle           String?
  seoDescription     String?
  lastReviewedAt     DateTime?
  editorialChecklist Json?
  isActive           Boolean       @default(true)
  country            Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  heroImage          Asset?        @relation("ContentPageHero", fields: [heroImageAssetId], references: [id], onDelete: SetNull)
  ogImage            Asset?        @relation("ContentPageOg", fields: [ogImageAssetId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([countryId, pageKey, locale])
}

enum ReviewProvider {
  TRUSTPILOT
  GOOGLE
  DOCTIFY
  INTERNAL
}

/**
 * Cached external reviews + aggregate snapshots. The admin Settings page
 * stores the configuration IDs separately (via `Setting` rows), but the
 * per-provider aggregate (rating + count) lives here so the public
 * ReviewBadge and `AggregateRating` JSON-LD can read a single row per
 * (countryId?, provider) combination.
 * When live API integrations land later (Trustpilot Business API,
 * Google Place Details, Doctify), they'll write to this table.
 */
model Review {
  id          String         @id @default(cuid())
  countryId   String?
  provider    ReviewProvider
  externalId  String?
  rating      Int
  title       String?
  body        String?
  authorName  String?
  sourceUrl   String?
  verifiedAt  DateTime?
  isApproved  Boolean        @default(true)
  publishedAt DateTime?
  country     Country?       @relation(fields: [countryId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([provider, externalId])
  @@index([countryId, provider])
}

/**
 * Site-wide key/value config the super-admin can edit without a deploy.
 * Used for review provider IDs, current aggregate ratings, support
 * contact info, and other settings that don't justify their own table.
 * Values are JSON so structured data (e.g. aggregate snapshots) fits
 * alongside plain strings.
 * Known keys (Phase 4):
 * review.trustpilot.businessUnitId   string
 * review.trustpilot.aggregate        { rating: number, count: number, updatedAt: iso8601 }
 * review.google.placeId              string
 * review.google.aggregate            { rating: number, count: number, updatedAt: iso8601 }
 * review.doctify.clinicId            string
 * review.doctify.aggregate           { rating: number, count: number, updatedAt: iso8601 }
 * review.primaryProvider             "TRUSTPILOT" | "GOOGLE" | "DOCTIFY"
 */
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Patient-upload magic-link tokens (SF5, code review 2026-07-05). Replaces
/// a stateless 100-year HMAC-signed token with a DB-backed, short-lived,
/// revocable one — only the hash of the bearer token is stored, so a DB
/// leak alone can't be used to forge uploads.
model PatientUploadLink {
  id            String    @id @default(cuid())
  /// SHA-256 hex digest of the bearer token — never store the raw token.
  tokenHash     String    @unique
  email         String
  appointmentId String
  doctorId      String
  /// Set when the link is bound to one exams prescription (v3 layout).
  documentId    String?
  expiresAt     DateTime
  /// Diagnostic only — last time the link was presented and accepted.
  usedAt        DateTime?
  /// Set when superseded by a freshly-minted link for the same scope, or by
  /// a future manual-revoke action.
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, appointmentId])
}

/// Audit trail for the same-day GP quick-book auto-assignment.
///
/// Written when the homepage timeslot-first flow resolves a GP doctor for a
/// chosen language + slot (POST /api/public/gp-assign). Keyed by the claimed
/// `timeSlotId` so the post-payment Appointment (which carries the same slot)
/// can back-fill `consultationLanguageCode` + `assignmentReason`, and so admins
/// can review WHY a given clinician was picked.
///
/// `reason` is one of: PRIORITY_24H (priority doctor inside the 24h window),
/// ROTATION (fair round-robin pick), ONLY_AVAILABLE (single eligible doctor).
model GpAssignmentLog {
  id           String   @id @default(cuid())
  /// The doctor's slot that was resolved + (subsequently) held. Unique so a
  /// re-resolve of the same slot upserts rather than duplicates.
  timeSlotId   String   @unique
  doctorId     String
  countryCode  String
  serviceId    String
  /// BCP-47 language the patient selected on the homepage dropdown.
  languageCode String
  reason       String
  createdAt    DateTime @default(now())

  @@index([countryCode, createdAt])
  @@index([doctorId, createdAt])
}

/// Clinical SOAP note bound to a single Appointment. Created lazily —
/// the row only materialises the first time the doctor saves something
/// from the portal. Locks on SIGN; further edits would require an
/// amendment row (out of scope today).
model Consultation {
  id             String                @id @default(cuid())
  appointmentId  String                @unique
  doctorId       String
  chiefComplaint String?
  /// SOAP: Subjective — patient-reported history.
  subjective     String?
  /// SOAP: Objective — observable findings, vitals, exam.
  objective      String?
  /// SOAP: Assessment — clinical impression, diagnoses.
  assessment     String?
  /// SOAP: Plan — prescriptions, follow-up, referrals.
  plan           String?
  status         ConsultationStatus    @default(DRAFT)
  signedAt       DateTime?
  appointment    Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor         Doctor                @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  /// Per-consult services-rendered line items.
  servicesUsed   ConsultationService[]
  /// Share links pointing at this consultation (signed referral URLs).
  shareLinks     ShareLink[]
  /// Clinical prescriptions issued during this consult.
  prescriptions  Prescription[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([doctorId, status])
}

/// Structured clinical prescription issued by the doctor during a
/// consultation. Distinct from `ServiceKind.PRESCRIPTION` services,
/// which are orderable products (a "shop item" the patient buys
/// without a clinical encounter — same pattern as HealthTest).
///
/// Drugs are stored as free-text for now (no formulary lookup).
/// Locked once the parent Consultation is SIGNED — further edits
/// would require an amendment row (out of scope today).
model Prescription {
  id             String       @id @default(cuid())
  consultationId String
  doctorId       String
  drugName       String
  /// Strength + form, e.g. "50 mg tablet", "10 mg/mL solution".
  dose           String?
  /// Dosing schedule, e.g. "1 tab twice daily", "as needed".
  frequency      String?
  /// How long to take it, in days. Null = ongoing / repeat.
  durationDays   Int?
  /// Free-text caveats: "with food", "do not drive", etc.
  instructions   String?
  /// Number of refills the patient is allowed without re-consulting.
  refills        Int          @default(0)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([consultationId, createdAt])
  @@index([doctorId, createdAt])
}

/// Per-appointment lab / imaging / test order or result the doctor
/// records. The same row covers two lifecycle states:
///   REQUESTED — doctor has ordered the test, result not in yet
///   COMPLETED — result recorded (notes / externalUrl populated)
/// `externalUrl` links to a partner lab portal; first-party PDFs live
/// on `AppointmentDocument` so clinical doc storage stays in one place.
model ExamResult {
  id            String      @id @default(cuid())
  appointmentId String
  doctorId      String
  testName      String
  status        ExamStatus  @default(COMPLETED)
  performedAt   DateTime?
  notes         String?
  externalUrl   String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId, createdAt])
  @@index([doctorId, createdAt])
  @@index([appointmentId, status])
}

/// Doctor ↔ admin per-appointment note thread. Distinct from the
/// patient-facing `Message` model — patients can never see these.
model InternalMessage {
  id            String                    @id @default(cuid())
  appointmentId String
  authorUserId  String
  authorRole    InternalMessageAuthorRole
  body          String
  appointment   Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author        User                      @relation("InternalMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime                  @default(now())

  @@index([appointmentId, createdAt])
}

/// Per-consultation services-rendered line item. The doctor records
/// which catalogue services they performed during the consult; admin
/// uses these rows for invoicing. `serviceId` links to the Service
/// catalogue row when one matches; `customLabel` carries free-text for
/// off-catalogue procedures.
model ConsultationService {
  id             String       @id @default(cuid())
  consultationId String
  serviceId      String?
  customLabel    String?
  quantity       Int          @default(1)
  unitPriceCents Int?
  currencyCode   String?
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  service        Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([consultationId])
}

/// Reusable form template (intake, pre-consult survey, post-consult
/// feedback). `fields` is a JSON array of `{ key, label, type, required,
/// options? }`. Validated server-side at submit time.
///
/// `doctorId = null` means an admin-managed shared template available to
/// every doctor; a set `doctorId` scopes the template to one practice.
model FormTemplate {
  id          String           @id @default(cuid())
  doctorId    String?
  title       String
  description String?
  fields      Json
  isActive    Boolean          @default(true)
  doctor      Doctor?          @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([doctorId, isActive])
}

/// One submission of a FormTemplate. `answers` is a JSON array of
/// `{ key, value }`. `appointmentId` ties it to a specific encounter;
/// `patientUserId` records the signed-in patient who filled it (null
/// for guest submissions or when the doctor logs answers on the
/// patient's behalf).
model FormSubmission {
  id            String       @id @default(cuid())
  templateId    String
  appointmentId String?
  patientUserId String?
  answers       Json
  submittedAt   DateTime     @default(now())
  template      FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientUser   User?        @relation(fields: [patientUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId, submittedAt])
  @@index([templateId, submittedAt])
}

/// Doctor portal notification. Polling-based today; the bell on the
/// doctor portal fetches unread count every minute. `payload` carries
/// per-type context (e.g. `{ appointmentId, snippet }`).
model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  type            NotificationType
  payload         Json
  readAt          DateTime?
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
}

/// Signed share link. Doctor generates one for a signed consultation
/// to hand off to a referring colleague; expires after the chosen
/// window (default 7 days). The token is the URL-safe random; never
/// reuse the row id for sharing.
model ShareLink {
  id              String         @id @default(cuid())
  scope           ShareLinkScope
  consultationId  String?
  /// SHA-256 hex digest of the bearer token — never store the raw token
  /// (S-009). The raw token only ever exists in the URL handed to the
  /// referring colleague.
  tokenHash       String         @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdByUserId String
  consultation    Consultation?  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("ShareLinkAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())

  @@index([consultationId])
}

/// Append-only audit trail for clinical + collaboration mutations.
/// Reads are admin-only via `/admin/audit-log`. Writers across the
/// codebase use the `recordAudit` helper instead of poking the table
/// directly so failures stay quiet (never block the underlying
/// mutation).
///
/// `entityType` carries the model name (`"Consultation"`,
/// `"ExamResult"`, `"InternalMessage"`, `"ShareLink"`,
/// `"FormSubmission"`, `"ConsultationService"`); `entityId` is the
/// affected row id. `metadata` JSON is free-form — typical keys are
/// `appointmentId`, `snippet`, `consultationId`.
model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  /// Snapshot of the actor's role at event time. Useful when a User
  /// later gets demoted (e.g. doctor de-linked) and we still want to
  /// see they signed a consult while they were a doctor.
  actorRole   String?
  action      AuditAction
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  countryDetected String?
  loginSessionId  String?
  actorUser   User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// First-party clinical documents the doctor attaches to an
/// appointment (PDFs, scans, photos). Stored in S3 under a
/// doctor-scoped key prefix. Kept separate from `Asset` (which is
/// marketing-side, admin-managed, and publicly addressable) so the
/// access surface is unambiguous.
model AppointmentDocument {
  id            String      @id @default(cuid())
  appointmentId String
  doctorId      String
  label         String
  storageKey    String
  mimetype      String
  byteSize      Int
  /// When a patient uploads via a per-prescription QR/link, the exams
  /// prescription (GeneratedDocument) this upload answers.
  sourceGeneratedDocumentId String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
  @@index([doctorId, createdAt])
}

/// Patient ↔ doctor chat thread per appointment. Open from booking
/// creation; auto-locks 24h after `Appointment.consultationCompletedAt`
/// (set when status moves to COMPLETED). Doctor can re-open via PATCH.
///
/// File attachments (PDFs, images) are stored the same way as
/// `AppointmentDocument` — directly in S3 under a patient-scoped key
/// prefix. `body` is nullable so a message can be attachment-only.
model ConsultationMessage {
  id            String         @id @default(cuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorRole    ChatAuthorRole
  authorUserId  String?
  body          String?
  /// S3 key for an attached file. Null when message is text-only.
  storageKey    String?
  fileName      String?
  mimeType      String?
  byteSize      Int?
  readByPatient Boolean        @default(false)
  readByDoctor  Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([appointmentId, createdAt])
}

/// Per-service FAQ entries managed by admin. Distinct from the global country-scoped Faq model
/// (which is for site-wide FAQ pages). ServiceFaq is for the FAQ section on each service detail page.
model ServiceFaq {
  id           String                  @id @default(cuid())
  serviceId    String
  question     String
  answer       String
  sortOrder    Int                     @default(0)
  isVisible    Boolean                 @default(true)
  service      Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Per-locale overrides; each field falls back to the base question/answer
  /// above (base = the service's country defaultLocale), same pattern as
  /// Service/ServiceTranslation.
  translations ServiceFaqTranslation[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([serviceId, isVisible, sortOrder])
}

/// Per-locale override of a ServiceFaq's question/answer text. Base columns
/// on ServiceFaq hold the country's default-locale copy; a row here overrides
/// for one other locale. sortOrder/isVisible stay on the base row — they are
/// locale-independent (same FAQ item, same position, translated text only).
model ServiceFaqTranslation {
  id           String     @id @default(cuid())
  serviceFaqId String
  locale       LocaleCode
  question     String
  answer       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  serviceFaq   ServiceFaq @relation(fields: [serviceFaqId], references: [id], onDelete: Cascade)

  @@unique([serviceFaqId, locale])
  @@index([serviceFaqId])
}

/// Per-health-test FAQ entries managed by admin. Mirrors ServiceFaq but scoped
/// to the health-test detail page FAQ accordion.
model HealthTestFaq {
  id            String      @id @default(cuid())
  healthTestId  String
  question      String
  answer        String
  sortOrder     Int         @default(0)
  isVisible     Boolean     @default(true)
  healthTest    HealthTest  @relation(fields: [healthTestId], references: [id], onDelete: Cascade)
  /// Per-locale overrides; base question/answer stay on this row as the
  /// country's default-locale copy, same pattern as ServiceFaq.
  translations  HealthTestFaqTranslation[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([healthTestId, isVisible, sortOrder])
}

/// Per-locale override of a HealthTestFaq's question/answer text. Base
/// columns on HealthTestFaq hold the country's default-locale copy; a row
/// here overrides for one other locale. sortOrder/isVisible remain on the
/// base row because they are locale-independent.
model HealthTestFaqTranslation {
  id              String        @id @default(cuid())
  healthTestFaqId String
  locale          LocaleCode
  question        String
  answer          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  healthTestFaq   HealthTestFaq @relation(fields: [healthTestFaqId], references: [id], onDelete: Cascade)

  @@unique([healthTestFaqId, locale])
  @@index([healthTestFaqId])
}

/// Patient nationality / identity documents. Max 2 per patient (slot 1 and slot 2).
/// slotNumber is constrained to 1 or 2 via service-layer guard (no DB enum needed).
model PatientNationalityDocument {
  id                 String             @id @default(cuid())
  patientProfileId   String
  globalHealthNumber String?
  slotNumber         Int                // 1 or 2 only — enforced in service layer
  nationalityCountry String
  documentType       String             // passport | id_card | residence_card | nicop | cnic | other
  /// AES-256-GCM encrypted (phi:v1: envelope).
  documentNumber     String?
  frontFileKey       String?            // S3 storageKey — never public URL
  backFileKey        String?
  expiryDate         DateTime?
  verificationStatus VerificationStatus @default(NOT_VERIFIED)
  adminNotes         String?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  patientProfile     PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([patientProfileId, slotNumber])
  @@index([patientProfileId])
}

/// Generic medical document. Covers patient uploads, doctor uploads, exam requests,
/// consultation summaries, prescription PDFs — anything attached to a patient's medical file.
/// visibleToPatient controls what the patient portal shows.
model MedicalDocument {
  id                    String   @id @default(cuid())
  patientProfileId      String
  globalHealthNumber    String?
  uploadedByUserId      String?
  uploadedByRole        String   // PATIENT | DOCTOR | ADMIN | SYSTEM
  documentType          String   // REPORT | EXAM_REQUEST | EXAM_RESULT | CONSULT_SUMMARY | PRESCRIPTION | OTHER
  title                 String
  description           String?
  fileKey               String   // S3 storageKey — never public URL
  fileName              String
  mimetype              String
  byteSize              Int
  relatedAppointmentId  String?
  relatedConsultationId String?
  visibleToPatient      Boolean  @default(false)
  patientProfile        PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([patientProfileId, documentType])
  @@index([patientProfileId, visibleToPatient])
  @@index([relatedAppointmentId])
}

/// Append-only GDPR consent history. Latest row per (patientProfileId, consentType) = current state.
/// Never update or delete rows — only append.
model PatientConsent {
  id                 String   @id @default(cuid())
  patientProfileId   String
  globalHealthNumber String?
  /// STORE_MEDICAL | SHARE_WITH_DOCTOR | MARKETING | THIRD_PARTY_LAB | NOTIFICATIONS | FOLLOW_UP
  consentType        String
  consentValue       Boolean
  consentVersion     String?
  /// PATIENT_PORTAL | ADMIN | SYSTEM | BOOKING_FORM
  source             String   @default("PATIENT_PORTAL")
  changedByUserId    String?
  changedByRole      String?
  patientProfile     PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())  // append-only — no updatedAt

  @@index([patientProfileId, consentType, createdAt])
}

/// Read-only medical access log. Immutable audit trail of who accessed a patient's
/// medical information and when. Never update or delete. Patient-facing (distinct from AuditLog).
model MedicalAccessLog {
  id                    String   @id @default(cuid())
  patientProfileId      String
  globalHealthNumber    String?
  accessedByUserId      String?
  accessedByRole        String   // DOCTOR | ADMIN | SUPER_ADMIN | STAFF | PATIENT | SYSTEM
  accessedByName        String?
  /// MEDICAL_DOC | CONSULT_NOTE | PRESCRIPTION | EXAM_REQUEST | EXAM_RESULT | ID_DOC | NATIONALITY_DOC | SENSITIVE_PROFILE | INSURANCE_DOC
  accessedResourceType  String
  accessedResourceId    String?
  /// VIEWED | DOWNLOADED | UPLOADED | UPDATED
  accessAction          String
  accessReason          String?
  relatedAppointmentId  String?
  ipAddress             String?
  userAgent             String?
  patientCountryFolder  String?
  actorCountry          String?
  consentLevelUsed      String?
  isAbnormal            Boolean  @default(false)
  abnormalReason        String?
  loginSessionId        String?
  patientProfile        PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())  // read-only — no updatedAt

  @@index([patientProfileId, createdAt])
  @@index([patientProfileId, accessedByRole])
}

/// Versioned consent text registry. Booking and portal reference the active
/// version so we can prove the exact wording a patient saw.
model ConsentDocument {
  id            String   @id @default(cuid())
  /// Matches PatientConsent.consentType values.
  consentKey    String
  version       String
  locale        LocaleCode @default(EN)
  bodyText      String
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([consentKey, version, locale])
  @@index([consentKey, isActive])
}

/// Doctor must accept this before accessing any patient records.
model DoctorConfidentialityAgreement {
  id               String   @id @default(cuid())
  doctorId         String
  agreementVersion String
  accepted         Boolean  @default(false)
  acceptedAt       DateTime?
  ipAddress        String?
  userAgent        String?
  doctor           Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([doctorId, accepted])
}

/// Doctor in country X requesting access to a patient file in country Y.
model MedicalAccessRequest {
  id                       String                     @id @default(cuid())
  patientProfileId         String
  globalHealthNumber       String?
  requestingDoctorId       String?
  requestingUserId         String?
  requestingDoctorCountry  String?
  patientOriginCountry     String?
  requestedAccessScope     String
  reason                   String
  status                   MedicalAccessRequestStatus @default(PENDING)
  requestedAt              DateTime                   @default(now())
  approvedAt               DateTime?
  deniedAt                 DateTime?
  expiresAt                DateTime?
  patientResponseIp        String?
  reviewedByUserId         String?
  patient                  PatientProfile             @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  reviewedByUser           User?                      @relation("MedicalAccessRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  grants                   MedicalAccessGrant[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([patientProfileId, status])
  @@index([requestingDoctorId, status])
}

/// Time-boxed access capability minted when a MedicalAccessRequest is approved.
/// The assertMedicalAccess guard checks live grants before allowing cross-country access.
model MedicalAccessGrant {
  id                    String               @id @default(cuid())
  accessRequestId       String
  patientProfileId      String
  grantedToUserId       String
  grantedToRole         String
  scope                 String
  expiresAt             DateTime
  revokedAt             DateTime?
  accessRequest         MedicalAccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  createdAt             DateTime             @default(now())

  @@index([patientProfileId, grantedToUserId, expiresAt])
  @@index([grantedToUserId, expiresAt])
}

/// Abnormal access / suspicious activity alert. Raised by assertMedicalAccess
/// and the login audit pipeline. Routed to relevant local/global admins.
model SecurityAlert {
  id                 String               @id @default(cuid())
  severity           SecurityAlertSeverity
  alertType          String
  patientId          String?
  globalHealthNumber String?
  actorId            String?
  actorRole          String?
  countryFolder      String?
  description        String
  /// JSON blob with extra context (ip, userAgent, resourceType, etc.)
  details            Json?
  dedupeKey          String?
  status             SecurityAlertStatus  @default(OPEN)
  resolvedAt         DateTime?
  resolvedByAdminId  String?
  relatedAccessLogId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, severity, createdAt])
  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@index([dedupeKey])
}

/// Audit log for patient email / phone changes.
model PatientContactChangeLog {
  id               String         @id @default(cuid())
  patientProfileId String
  globalHealthNumber String?
  changedById      String?
  changedByRole    String
  fieldChanged     String         // EMAIL | PHONE
  oldValue         String?
  newValue         String?
  reason           String?
  ipAddress        String?
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([patientProfileId, createdAt])
}

/// Tracks patient profile merges. Both full JSON snapshots are saved before
/// any FK re-pointing so the merge is reversible by an admin.
model PatientMergeLog {
  id                          String         @id @default(cuid())
  primaryPatientId            String
  duplicatePatientId          String
  globalHealthNumberPrimary   String?
  globalHealthNumberDuplicate String?
  mergedByAdminId             String?
  reason                      String?
  /// Full JSON snapshot of both records taken before merge.
  primarySnapshot             Json?
  duplicateSnapshot           Json?
  patientInformed             Boolean        @default(false)
  primaryPatient              PatientProfile @relation("PatientMergeSource", fields: [primaryPatientId], references: [id], onDelete: Restrict)
  createdAt                   DateTime       @default(now())

  @@index([primaryPatientId])
  @@index([duplicatePatientId])
}

/// Per-country configurable data retention and storage residency policy.
model CountryDataPolicy {
  id                    String   @id @default(cuid())
  countryId             String   @unique
  countryCode           String   @unique
  retentionYears        Int      @default(10)
  /// EU | BR | US | Other
  storageRegion         String   @default("EU")
  requiresLocalStorage  Boolean  @default(false)
  legalNotes            String?
  isActive              Boolean  @default(true)
  country               Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Per-country legal entity, registration, and dispute-resolution details.
model CountryLegalProfile {
  id                         String   @id @default(cuid())
  countryId                  String   @unique
  country                    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  // Company / contact
  legalCompanyName           String?
  legalAddress               String?
  publicPhones               String[] @default([])
  publicEmails               String[] @default([])
  supportEmail               String?
  billingEmail               String?

  // Registration / regulatory
  companyRegistrationNumber  String?
  taxVatNumber               String?
  medicalRegistrationNumber  String?
  healthcareLicenseDetails   String?
  regulatorName              String?
  regulatorWebsite           String?

  // Provider-level healthcare registration shown prominently in the footer
  // trust bar (e.g. Portugal ERS: "Registado na Entidade Reguladora da
  // Saúde" / "E179287" / ers.pt). Ireland has no equivalent provider
  // registration so these stay null there.
  providerRegistrationLabel  String?
  providerRegistrationNumber String?
  providerRegistrationUrl    String?

  // Emergency + non-emergency health signposting for the footer trust bar
  // and medical disclaimers. `emergencyNumber` defaults to the EU-wide 112;
  // `nonEmergencyHealthLine` carries lines like "SNS 24: 1414" (Portugal).
  emergencyNumber            String?  @default("112")
  emergencyNotice            String?
  nonEmergencyHealthLine     String?

  // Legal backlinks
  companyRegistryUrl         String?
  medicalRegulatorUrl        String?
  healthcareAuthorityUrl     String?
  dataProtectionAuthorityUrl String?
  disputeResolutionUrl       String?
  consumerProtectionUrl      String?

  // Data-protection naming (overrides hardcoded "GDPR")
  dataProtectionLawName      String?  @default("GDPR")
  dataProtectionPolicyTitle  String?
  dpoName                    String?
  dpoEmail                   String?

  // Dispute resolution
  disputeBodyName            String?
  disputeEmail               String?
  disputePhone               String?
  disputeProcessText         String?
  legalJurisdictionText      String?
  consumerRightsText         String?

  // Medical disclaimers. Two reusable copies edited per country in the admin
  // legal profile. `shortDisclaimer` is the condensed version embedded on
  // service pages, the GP listing, the booking flow consent step and doctor
  // profiles. `fullDisclaimer` is the long-form text shown on the standalone
  // /legal page and linked from the footer. Both are plain multi-paragraph
  // text (paragraphs separated by blank lines). These base columns hold the
  // country's DEFAULT-locale copy and act as the fallback; per-locale overrides
  // live in `disclaimerTranslations`. Null until an admin fills them in.
  shortDisclaimer            String?
  fullDisclaimer             String?
  disclaimerTranslations     CountryDisclaimerTranslation[]

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

/// Per-locale override of the medical disclaimers. One row per (legal profile,
/// locale). Mirrors ServiceTranslation: each field falls back to the base
/// CountryLegalProfile column (default-locale copy) when null/absent, so a
/// translation row may fill just one field. Only non-default locales need rows.
model CountryDisclaimerTranslation {
  id              String              @id @default(cuid())
  legalProfileId  String
  locale          LocaleCode
  shortDisclaimer String?
  fullDisclaimer  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  legalProfile    CountryLegalProfile @relation(fields: [legalProfileId], references: [id], onDelete: Cascade)

  @@unique([legalProfileId, locale])
  @@index([legalProfileId])
}

/// Category of an official authority so the frontend can group + place links
/// correctly (footer trust bar, mental-health helplines on psychiatry pages,
/// medicines body on prescription pages, etc.) and so schema `sameAs` only
/// includes genuine regulators.
enum AuthorityCategory {
  MEDICAL_REGULATOR
  DOCTOR_REGISTRY
  HEALTH_AUTHORITY
  DATA_PROTECTION
  MEDICINES
  PROFESSIONAL_BODY
  CONSUMER_PROTECTION
  MENTAL_HEALTH
  COMPLAINTS
  EMERGENCY
  OTHER
}

/// One official medical / regulatory / consumer authority for a country, with
/// its public verification URL. Replaces the single-slot URL fields on
/// CountryLegalProfile for the many-authority markets (Ireland, Portugal).
model CountryAuthorityLink {
  id           String            @id @default(cuid())
  countryId    String
  country      Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name         String
  abbreviation String?
  url          String
  category     AuthorityCategory @default(OTHER)
  description  String?
  /// Show in the persistent footer trust bar (mandatory regulators only).
  showInFooter Boolean           @default(false)
  /// Include in Organization/MedicalBusiness JSON-LD `sameAs`.
  showInSchema Boolean           @default(true)
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([countryId, isActive])
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  COOKIE_POLICY
  GDPR_NOTICE
  DATA_PROCESSING_AGREEMENT
  REFUND_POLICY
  MEDICAL_DISCLAIMER
  ACCESSIBILITY_STATEMENT
}

/// Per-country legal documents (rich text and/or PDF).
model CountryLegalDocument {
  id          String            @id @default(cuid())
  countryId   String
  country     Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  type        LegalDocumentType
  title       String
  content     String?
  pdfPath     String?
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  locale      String            @default("en")
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([countryId, type, locale])
}

/// Patient GDPR data deletion request. Medical records that must be retained
/// under local law are anonymized rather than deleted.
model DataDeletionRequest {
  id                        String             @id @default(cuid())
  patientProfileId          String
  globalHealthNumber        String?
  requestStatus             DataDeletionStatus @default(SUBMITTED)
  requestedAt               DateTime           @default(now())
  reviewedByAdminId         String?
  reviewedAt                DateTime?
  legalReasonForRetention   String?
  completedAt               DateTime?
  patientNotificationSent   Boolean            @default(false)
  notes                     String?
  patient                   PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([patientProfileId, requestStatus])
  @@index([requestStatus, createdAt])
}

// ─── Bootstrap tracking tables ───────────────────────────────────────────────
// These tables are managed outside of Prisma migrations (ensure-schema.ts).
// They are modelled here so Prisma does not attempt to DROP them during
// `migrate dev` / `migrate diff` runs.

/// GHN counter: one row per calendar year. Incremented atomically with
/// SELECT ... FOR UPDATE to generate monotonic global health numbers.
/// Created by ensure-schema.ts; modelled here so Prisma knows it exists.
model GhnCounter {
  year    String @id
  lastSeq BigInt @default(0) @map("last_seq")

  @@map("ghn_counter")
}

/// Monotonic counter for ORD-000001 style order numbers.
model OrderCounter {
  id      Int @id @default(1)
  lastSeq Int @default(0) @map("last_seq")

  @@map("order_counter")
}

/// Per-country monotonic counter for invoice numbers (IE-00001, CZ-00001, etc.).
/// Incremented atomically with raw SQL UPDATE … RETURNING (same pattern as order_counter).
model InvoiceCounter {
  countryCode String @id
  lastSeq     Int    @default(0) @map("last_seq")

  @@map("invoice_counter")
}

/// Fiscal document tied to an Order. The type reflects how the booking was paid:
///   INVOICE          — manual / AI-agent booking, issued unpaid; patient pays later.
///   RECEIPT          — an INVOICE that has since been paid (same number, relabeled).
///   INVOICE_RECEIPT  — direct website checkout, paid on issue; acts as both.
enum InvoiceDocumentType {
  INVOICE
  RECEIPT
  INVOICE_RECEIPT
  /// CREDIT_NOTE — issued on refund, reverses a paid INVOICE_RECEIPT/RECEIPT
  /// (Portugal excluded; PT credit notes live in InvoiceExpress).
  CREDIT_NOTE
}

/// Invoice/receipt tied to an Order (Portugal excluded).
/// invoiceNumber is the human-facing reference: IE-00001, CZ-00001, SP-00001, RO-00001.
/// The same number is reused when an INVOICE transitions to a RECEIPT on payment.
/// An order normally has ONE fiscal document, plus at most one CREDIT_NOTE issued
/// on refund — hence orderId is indexed, not unique.
model Invoice {
  id            String              @id @default(cuid())
  invoiceNumber String              @unique
  orderId       String
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  countryCode   String
  documentType  InvoiceDocumentType @default(INVOICE_RECEIPT)
  generatedAt   DateTime            @default(now())
  emailSentAt   DateTime?
  emailSentTo   String?

  @@map("invoices")
  @@index([orderId])
  @@index([countryCode, generatedAt(sort: Desc)])
  @@index([documentType, generatedAt(sort: Desc)])
}

/// Tracks which ensure-schema.ts patches have been applied to a database.
/// Bootstrap-only — not used by application business logic. Will be removed
/// once ensure-schema.ts is fully retired in favour of Prisma migrations.
model EnsureSchemaPatch {
  name      String   @id
  appliedAt DateTime @default(now())

  @@map("_EnsureSchemaPatches")
  @@ignore
}

// ============================================================================
// SUBSCRIPTIONS (Wave 0) — see docs/plans/subscription-plan-implementation.md
// §20 schema checklist. Composite FKs + partial-unique indexes that Prisma
// cannot express are added as RAW SQL in the migration (commented there).
// ============================================================================

enum BillingInterval {
  MONTHLY
}

enum PlanType {
  ESSENTIAL
  COMPREHENSIVE
  PREMIUM
}

enum VatMode {
  EXEMPT
  STANDARD
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum CreditKind {
  CONSULTATION
  WELLNESS
}

enum PlanDiscountMode {
  NONE
  PERCENT
  FIXED
}

enum ConsultationLedgerReason {
  MONTHLY_GRANT
  RESET_EXPIRE
  RESERVED
  CONSUMED
  RELEASED
  ADJUSTMENT
  CLAWBACK
}

enum WellnessLedgerReason {
  MONTHLY_EARN
  RESERVED
  REDEEMED
  RELEASED
  ADJUSTMENT
  CLAWBACK
}

enum PerkKey {
  SPECIALIST_DISCOUNT
  FAMILY_USAGE
  WELLNESS_REDEMPTION
  TEST_KIT_REDEMPTION
  HIGHER_DISCOUNT_TIER
}

enum PerkUnlockMode {
  MONTH_1
  AFTER_PAID_MONTHS
  MANUAL_APPROVAL
  NOT_AVAILABLE
}

enum PerkGrantStatus {
  PENDING
  APPROVED
  DENIED
  AUTO
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  CANCELED
}

/// Per-locale display copy for a plan. Base columns on PricingPlan are the
/// default-locale fallback (matches HealthTestTranslation pattern). §20.
model PlanTranslation {
  id               String      @id @default(cuid())
  planId           String
  locale           LocaleCode
  name             String
  shortDescription String?
  longDescription  String?
  notesTerms       String?
  /// Admin-editable public card "Includes" bullets for this locale. When
  /// non-empty, these REPLACE the auto-generated bullets on the pricing card;
  /// when empty, the card falls back to the data-driven defaults. Display-only
  /// (never affects billing/credits/eligibility — §12).
  features         String[]    @default([])
  plan             PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, locale])
}

/// Links a plan to an existing per-country Service with credit/discount/unlock
/// config. `serviceId` → Service (D16, no ConsultationType entity). `countryId`
/// is copied from plan.countryId; two RAW-SQL composite FKs ((serviceId,
/// countryId)→Service and (planId, countryId)→PricingPlan) make cross-country
/// corruption structurally impossible (§36.10). PRESCRIPTION services are
/// rejected at the API (§36.11).
model PlanConsultationRule {
  id                  String           @id @default(cuid())
  planId              String
  /// Always == plan.countryId (app-enforced + composite-FK enforced).
  countryId           String
  serviceId           String
  isIncluded          Boolean          @default(false)
  usesCredits         Boolean          @default(false)
  creditsPerUse       Int              @default(1)
  discountMode        PlanDiscountMode @default(NONE)
  discountPercent     Float?
  fixedPriceCents     Int?
  unlockAfterPaidMonths Int            @default(0)
  familyUsable        Boolean          @default(false)
  isActive            Boolean          @default(true)
  plan                PricingPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  service             Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([planId, serviceId])
  @@index([countryId])
}

/// Per-plan perk unlock rule. Manual-approval STATE is per-subscriber on
/// SubscriptionPerkGrant — NOT here (§36.13).
model PlanPerkRule {
  id                    String         @id @default(cuid())
  planId                String
  perkKey               PerkKey
  unlockMode            PerkUnlockMode @default(MONTH_1)
  unlockAfterPaidMonths Int?
  plan                  PricingPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([planId, perkKey])
}

/// Per-plan health-test redemption rule. Active subscription is ALWAYS
/// required (D6 — no toggle). §11/§20.
model HealthTestKitRedemptionRule {
  id                    String      @id @default(cuid())
  planId                String
  healthTestId          String
  requiredWellnessCredits Int
  unlockAfterPaidMonths Int         @default(0)
  isActive              Boolean     @default(true)
  plan                  PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  healthTest            HealthTest  @relation(fields: [healthTestId], references: [id], onDelete: Cascade)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([planId, healthTestId])
}

/// A user's subscription. Pricing + grants read `planSnapshot` (D18), not the
/// live plan. One active per user — RAW-SQL partial unique on userId for
/// active statuses (§36.8).
model UserSubscription {
  id                        String                     @id @default(cuid())
  userId                    String
  patientProfileId          String?
  planId                    String
  countryCode               String
  status                    SubscriptionStatus         @default(INCOMPLETE)
  stripeSubscriptionId      String?                    @unique
  stripeCustomerId          String?
  /// Grandfathered Price this sub is billed on (may differ from the plan's
  /// current stripePriceId) — D22.
  stripePriceId             String?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  paidMonthsCount           Int                        @default(0)
  cancelAtPeriodEnd         Boolean                    @default(false)
  /// Scheduled (next-cycle) plan change — Q10=B.
  pendingPlanId             String?
  pendingStripePriceId      String?
  pendingChangeEffectiveAt  DateTime?
  stripeSubscriptionScheduleId String?
  /// Resolved plan terms captured at subscribe + each renewal (D18/§36.16).
  planSnapshot              Json?
  snapshotVersion           Int                        @default(0)
  startedAt                 DateTime?
  canceledAt                DateTime?
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                      PricingPlan                @relation(fields: [planId], references: [id])
  balances                  SubscriptionCreditBalance[]
  consultationLedger        ConsultationCreditLedger[]
  wellnessLedger            WellnessCreditLedger[]
  perkGrants                SubscriptionPerkGrant[]
  redemptions               HealthTestRedemption[]
  invoices                  SubscriptionInvoice[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
}

/// Live balance counter — the SOLE spend authority (§36.1). Mutated via atomic
/// conditional UPDATE; the ledger is the audit trail.
model SubscriptionCreditBalance {
  id                 String           @id @default(cuid())
  userSubscriptionId String
  kind               CreditKind
  balance            Int              @default(0)
  subscription       UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  updatedAt          DateTime         @updatedAt

  @@unique([userSubscriptionId, kind])
}

/// Append-only consultation-credit ledger (audit). `balanceAfterHint` is
/// advisory; the counter is authority. Reservation lifecycle: RESERVED(-1) →
/// terminal CONSUMED(0) | RELEASED(+1). RAW-SQL partial unique on reservationId
/// WHERE reason IN ('CONSUMED','RELEASED') enforces commit/release exclusivity.
model ConsultationCreditLedger {
  id                 String                   @id @default(cuid())
  userSubscriptionId String
  userId             String
  deltaCredits       Int
  reason             ConsultationLedgerReason
  balanceAfterHint   Int?
  reservationId      String?
  orderItemId        String?
  serviceId          String?
  /// Cart-first path only — never the manual appointments.route.ts path (§36.17).
  appointmentId      String?
  reservedUntil      DateTime?
  billingPeriodStart DateTime?
  idempotencyKey     String                   @unique
  subscription       UserSubscription         @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  createdAt          DateTime                 @default(now())

  @@index([userSubscriptionId, reason])
  @@index([reservationId])
}

/// Append-only wellness-credit ledger. No monthly reset/expiry (D13). Earned
/// only on Premium (D12). Reservation lifecycle mirrors consultation; RAW-SQL
/// partial unique on reservationId WHERE reason IN ('REDEEMED','RELEASED').
model WellnessCreditLedger {
  id                 String               @id @default(cuid())
  userSubscriptionId String
  userId             String
  deltaCredits       Int
  reason             WellnessLedgerReason
  balanceAfterHint   Int?
  /// = HealthTestRedemption.id for a reservation group.
  reservationId      String?
  reservedUntil      DateTime?
  healthTestId       String?
  redemptionId       String?
  idempotencyKey     String               @unique
  subscription       UserSubscription     @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())

  @@index([userSubscriptionId, reason])
  @@index([reservationId])
}

/// Per-subscriber perk grant (manual-approval state lives here, not on the
/// plan rule — §36.13).
model SubscriptionPerkGrant {
  id                 String           @id @default(cuid())
  userSubscriptionId String
  perkKey            PerkKey
  status             PerkGrantStatus  @default(PENDING)
  approvedByAdminId  String?
  approvedAt         DateTime?
  subscription       UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([userSubscriptionId, perkKey])
  @@index([status])
}

/// Wellness-credit health-kit redemption. Reuses Order/OrderItem for
/// fulfilment (€0 kit line + postage in Order.shippingCents). §11.
model HealthTestRedemption {
  id                  String           @id @default(cuid())
  userId              String
  userSubscriptionId  String
  healthTestId        String
  orderId             String?          @unique
  wellnessCreditsSpent Int
  status              RedemptionStatus @default(REQUESTED)
  subscription        UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  healthTest          HealthTest       @relation(fields: [healthTestId], references: [id])
  order               Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())

  @@index([userId])
  @@index([status])
}

/// Account-page mirror of Stripe-hosted subscription invoices. Stripe is the
/// system of record (§38.1) — this only renders /account/payments.
model SubscriptionInvoice {
  id                 String           @id @default(cuid())
  userSubscriptionId String
  stripeInvoiceId    String           @unique
  number             String?
  amountPaidCents    Int
  currency           String
  taxCents           Int              @default(0)
  periodStart        DateTime?
  hostedInvoiceUrl   String?
  pdfUrl             String?
  status             String?
  subscription       UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@index([userSubscriptionId])
}

/// Audit trail of immutable Stripe Price versions per plan (§22). Optional but
/// recommended for reconciliation.
model PlanStripePrice {
  id            String      @id @default(cuid())
  planId        String
  stripePriceId String      @unique
  amountCents   Int
  currency      String
  active        Boolean     @default(true)
  plan          PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  archivedAt    DateTime?

  @@index([planId])
}

/// Family member under a primary account. Wave 5 (D20) — table created now,
/// seeded off; the flow ships later.
model FamilyMember {
  id               String    @id @default(cuid())
  primaryUserId    String
  patientProfileId String?
  fullName         String
  email            String?
  dateOfBirth      DateTime?
  relationship     String?
  canUseCredits    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  /// Cart/order consultation lines booked for this dependent (Premium
  /// family usage). SetNull on delete keeps historical order lines intact.
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([primaryUserId])
}

// ---------------------------------------------------------------------------
// Corporate Plan (private B2B) — docs/plans/corporate-plan-implementation.md
// Companies buy the Corporate Standard plan (EUR 180/employee/year, offline
// annual billing). Employees + up to 5 beneficiaries each get a digital
// benefit card and a configurable % discount on eligible consultations.
// Deliberately SEPARATE from the PricingPlan/UserSubscription engine —
// that one is monthly-Stripe-billed, credit-based, per-user opt-in; this
// one is company-billed, automatic, membership-derived.
// ---------------------------------------------------------------------------

/// Who may see/book a Service. Non-PUBLIC values are excluded from every
/// public surface server-side (listings, slug lookup, slots, cart-add).
enum ServiceVisibility {
  PUBLIC
  CORPORATE_ONLY          // corporate employee onboarding (pre-assessment)
  CORPORATE_REQUEST_ONLY  // bookable only against an open CorporateServiceRequest
  ADMIN_ONLY              // internal
}

enum CorporateCompanyStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum CorporateEmployeeStatus {
  DRAFT
  INVITED
  INVITE_SENT
  INVITE_FAILED
  REGISTERED
  PROFILE_INCOMPLETE
  PROFILE_COMPLETE
  PREASSESSMENT_PENDING
  PREASSESSMENT_BOOKED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CorporateBeneficiaryStatus {
  INVITED
  INVITE_SENT
  INVITE_FAILED
  REGISTERED
  PROFILE_INCOMPLETE
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CorporateInviteType {
  EMPLOYEE
  BENEFICIARY
}

enum CorporateMemberType {
  EMPLOYEE
  BENEFICIARY
}

enum CorporateCardStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum CorporateRequestType {
  ILLNESS_BENEFIT
  FIT_FOR_WORK
}

enum CorporateRequestStatus {
  REQUESTED
  EMPLOYEE_NOTIFIED
  BOOKED
  COMPLETED
  CANCELLED
  EXPIRED
}

/// A private B2B plan (not shown anywhere on the public site). v1 seed:
/// slug "corporate-standard", EUR 180/employee/year, max 5 beneficiaries.
model CorporatePlan {
  id                          String                 @id @default(cuid())
  slug                        String                 @unique
  name                        String
  annualPricePerEmployeeCents Int
  currencyCode                String                 @default("EUR")
  maxBeneficiariesPerEmployee Int                    @default(5)
  isActive                    Boolean                @default(true)
  benefitRules                CorporateBenefitRule[]
  includedServices            CorporatePlanService[]
  companies                   CorporateCompany[]
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
}

/// What a plan-assigned service is FOR. PRE_ASSESSMENT / ILLNESS_BENEFIT /
/// FIT_FOR_WORK drive the corporate flows (resolved by the assigned
/// service's SLUG in the company's country, since Service rows are
/// per-country); INCLUDED is a plain "part of the plan" listing.
enum CorporatePlanServiceRole {
  INCLUDED
  PRE_ASSESSMENT
  ILLNESS_BENEFIT
  FIT_FOR_WORK
}

/// Admin-assigned service included in a corporate plan. The serviceId is a
/// representative row (any country); runtime resolution goes slug + the
/// company's countryCode.
model CorporatePlanService {
  id              String                   @id @default(cuid())
  corporatePlanId String
  corporatePlan   CorporatePlan            @relation(fields: [corporatePlanId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  role            CorporatePlanServiceRole @default(INCLUDED)
  createdAt       DateTime                 @default(now())

  @@unique([corporatePlanId, serviceId])
  @@index([corporatePlanId])
}

/// Configurable discount rule. Matches by pinned serviceId (takes
/// precedence) or by ServiceKind (GENERAL = GP consultations). v1 seed:
/// { serviceKind: GENERAL, discountPercent: 10, appliesToBeneficiaries: true }.
model CorporateBenefitRule {
  id                     String        @id @default(cuid())
  corporatePlanId        String
  corporatePlan          CorporatePlan @relation(fields: [corporatePlanId], references: [id], onDelete: Cascade)
  serviceKind            ServiceKind?
  serviceId              String?
  service                Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  discountPercent        Float
  appliesToBeneficiaries Boolean       @default(true)
  isActive               Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([corporatePlanId, isActive])
}

model CorporateCompany {
  id                    String                    @id @default(cuid())
  name                  String
  registrationNumber    String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  postalCode            String?
  /// ISO-2 lowercase, same convention as Country.code / folders.
  countryCode           String
  billingEmail          String
  contactName           String
  contactEmail          String
  contactPhone          String?
  status                CorporateCompanyStatus    @default(ACTIVE)
  planId                String
  plan                  CorporatePlan             @relation(fields: [planId], references: [id])
  /// The CORPORATE_ADMIN login for this company (1:1). SetNull keeps the
  /// company when the login is deleted; admin re-invites a new one.
  adminUserId           String?                   @unique
  adminUser             User?                     @relation("CorporateCompanyAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  /// "Selected Doctor/Admin" — employee pre-assessments are pinned to
  /// this doctor when set (server-enforced at booking time).
  preAssessmentDoctorId String?
  preAssessmentDoctor   Doctor?                   @relation(fields: [preAssessmentDoctorId], references: [id], onDelete: SetNull)
  contractStartAt       DateTime                  @default(now())
  /// null = open-ended. A past date kills discounts + cards (checked
  /// live at pricing time; daily cron flips status to EXPIRED).
  contractEndAt         DateTime?
  employees             CorporateEmployee[]
  beneficiaries         CorporateBeneficiary[]
  serviceRequests       CorporateServiceRequest[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([countryCode, status])
}

model CorporateEmployee {
  id                         String                    @id @default(cuid())
  companyId                  String
  company                    CorporateCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Linked at invite accept (existing account or freshly created one).
  userId                     String?
  user                       User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName                  String
  lastName                   String
  email                      String
  phone                      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  postalCode                 String?
  dateOfBirth                DateTime?
  employeeCode               String?
  department                 String?
  jobTitle                   String?
  status                     CorporateEmployeeStatus   @default(DRAFT)
  /// The onboarding pre-assessment appointment, once booked.
  preAssessmentAppointmentId String?                   @unique
  preAssessmentAppointment   Appointment?              @relation(fields: [preAssessmentAppointmentId], references: [id], onDelete: SetNull)
  beneficiaries              CorporateBeneficiary[]
  invites                    CorporateInvite[]
  benefitCard                CorporateBenefitCard?
  serviceRequests            CorporateServiceRequest[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@unique([companyId, email])
  @@index([userId])
  @@index([companyId, status])
}

model CorporateBeneficiary {
  id           String                     @id @default(cuid())
  employeeId   String
  employee     CorporateEmployee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId    String
  company      CorporateCompany           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName    String
  lastName     String
  email        String
  phone        String?
  relationship String
  addressLine1 String?
  city         String?
  postalCode   String?
  dateOfBirth  DateTime?
  notes        String?
  status       CorporateBeneficiaryStatus @default(INVITED)
  invites      CorporateInvite[]
  benefitCard  CorporateBenefitCard?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([employeeId, email])
  @@index([userId])
  @@index([companyId, status])
}

/// Secure invite. Raw token is 32 crypto-random bytes, NEVER stored —
/// sha256 hash only (same posture as PasswordResetToken). 7-day expiry,
/// single use, carries no PII.
model CorporateInvite {
  id             String                @id @default(cuid())
  type           CorporateInviteType
  tokenHash      String                @unique
  employeeId     String?
  employee       CorporateEmployee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  beneficiaryId  String?
  beneficiary    CorporateBeneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  email          String
  expiresAt      DateTime
  usedAt         DateTime?
  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  lastSendError  String?
  /// Set when the +3-day unused-invite reminder went out (cron dedup).
  reminderSentAt DateTime?
  createdAt      DateTime              @default(now())

  @@index([employeeId])
  @@index([beneficiaryId])
}

/// Digital benefit card. One per active employee / beneficiary. Verified
/// publicly via GET /api/corporate/card-verify/:cardNumber.
model CorporateBenefitCard {
  id            String                @id @default(cuid())
  cardNumber    String                @unique
  memberType    CorporateMemberType
  employeeId    String?               @unique
  employee      CorporateEmployee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  beneficiaryId String?               @unique
  beneficiary   CorporateBeneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  status        CorporateCardStatus   @default(ACTIVE)
  validFrom     DateTime              @default(now())
  validUntil    DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

/// Illness-Benefit / Fit-for-Work request raised by the corporate admin
/// (or platform admin) for a specific employee. The linked service is
/// CORPORATE_REQUEST_ONLY, so the employee can only book it while an
/// open request row exists.
model CorporateServiceRequest {
  id                String                 @id @default(cuid())
  companyId         String
  company           CorporateCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          CorporateEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type              CorporateRequestType
  serviceId         String
  service           Service                @relation(fields: [serviceId], references: [id])
  requestedByUserId String
  reason            String?
  status            CorporateRequestStatus @default(REQUESTED)
  appointmentId     String?                @unique
  appointment       Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  /// Default +60 days; daily cron flips overdue open requests to EXPIRED.
  expiresAt         DateTime?
  notifiedAt        DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([companyId, status])
  @@index([employeeId, status])
}
