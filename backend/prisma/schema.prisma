model Badge {
  id        String   @id @default(cuid())
  countryId String
  assetId   String?
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A partner organisation shown in the per-country "Our partners" marquee on
/// the country home page. Admin-managed: logo (optional Asset), display name,
/// and an outbound website link. `sortOrder` controls marquee order.
model Partner {
  id         String   @id @default(cuid())
  countryId  String
  assetId    String?
  name       String
  websiteUrl String?
  /** Relationship label shown on the public tile, e.g. "Healthcare Partner",
   *  "Diagnostic Partner", "Client". Free text; null = no label. */
  type       String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  asset      Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
