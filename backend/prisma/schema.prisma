// Account model (planning): there is no User/UserRole in this schema yet.
// Future auth on THIS website should be PATIENT | ADMIN only.
// The Doctor model below is public marketing/directory data — not a login identity.
// Clinical doctor accounts belong to a separate doctor portal (deferred, out of scope).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LocaleCode {
  EN
  PT
  ES
  CS
  RO
  DE
}

enum AssetKind {
  IMAGE
  ICON
  LOGO
  BADGE
  SOCIAL
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ServiceKind {
  GENERAL
  SPECIALIST
  PRESCRIPTION
  HEALTH_TEST
  HOME_DELIVERY
}

enum UserRole {
  PATIENT
  ADMIN
  /// Clinician account — logs in to /doctor and sees only their own
  /// patients + appointments. Linked to a Doctor profile via
  /// `User.doctorId` (one-to-one).
  DOCTOR
  LOCAL_ADMIN  // country-scoped admin — accesses only allowedCountryFolders
  SUPER_ADMIN  // same as ADMIN; explicit superuser role
  /// Company HR/admin for the private B2B corporate plan. Logs into
  /// /corporate; scoped to the single CorporateCompany whose
  /// `adminUserId` points at this user. No public/patient features.
  CORPORATE_ADMIN
}

enum PageKey {
  HOME
  GENERAL_CONSULTATION
  SPECIALIST_CONSULTATION
  DOCTORS_INDEX
  PRESCRIPTIONS
  HEALTH_TESTS
}

/// Lifecycle for a concrete bookable slot on a doctor's calendar.
///   OPEN     — published, can be claimed by a booking
///   HELD     — temporarily reserved (e.g. patient in checkout)
///   BOOKED   — claimed by an Appointment row
///   BLOCKED  — admin/doctor marked it unavailable (vacation, sick day, training)
enum DoctorSlotStatus {
  OPEN
  HELD
  BOOKED
  BLOCKED
}

/// Clinical consultation lifecycle.
///   DRAFT  — doctor is still editing
///   SIGNED — locked; further edits require a new amendment (out of scope)
enum ConsultationStatus {
  DRAFT
  SIGNED
}

/// Author side for internal (doctor ↔ admin) per-appointment notes. Kept
/// separate from the patient-facing `MessageAuthorRole` so we never mix
/// the two threads.
enum InternalMessageAuthorRole {
  DOCTOR
  ADMIN
}

/// Doctor portal notification kinds. Add new values here as we wire
/// more trigger points; the payload Json field carries the per-event
/// context (appointmentId, internalMessageId, etc.).
enum NotificationType {
  APPOINTMENT_ASSIGNED
  APPOINTMENT_STATUS_CHANGED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_FOLLOWUP_BOOKED
  APPOINTMENT_REMINDER
  INTERNAL_MESSAGE
  CONSULT_SIGNED
  EXAM_LOGGED
  EXAM_REQUESTED
  FORM_SUBMITTED
  DOCUMENT_UPLOADED
  // Patient subscription/plan in-app notifications (§30). Payload carries a
  // pre-localized { title, body, href } so the bell + list render directly.
  SUBSCRIPTION_CONFIRMED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_RENEWAL_REMINDER
  SUBSCRIPTION_PERK_UNLOCKED
  WELLNESS_CREDITS_EARNED
  KIT_REDEMPTION_CONFIRMED
  // Patient-facing chat notifications. PATIENT_MESSAGE notifies the recipient
  // staff side (admin for the clinic thread, doctor for the consult thread)
  // when a patient sends a message. MESSAGE_REPLY notifies the patient when
  // the clinic or their doctor replies. Payload carries appointmentId + a
  // snippet (staff bell) or { title, body, href } (patient bell).
  PATIENT_MESSAGE
  MESSAGE_REPLY
  // Corporate plan (private B2B). Payload carries pre-localized
  // { title, body, href } for the patient bell.
  CORPORATE_REQUEST_CREATED // company requested an Illness-Benefit / Fit-for-Work consult for the employee
  CORPORATE_MEMBERSHIP // membership activated / card issued / suspended / expired
}

/// Exam lifecycle.
///   REQUESTED — doctor wants this test run; result hasn't been logged yet
///   COMPLETED — result has been recorded (notes / externalUrl)
enum ExamStatus {
  REQUESTED
  COMPLETED
}

/// Scope for a `ShareLink` token. CONSULTATION = doctor sharing a
/// signed consult with a referring colleague via signed URL.
enum ShareLinkScope {
  CONSULTATION
  PATIENT_UPLOAD
}

/// System-generated clinical letters (absence cert, exams Rx, prescription).
enum GeneratedDocumentType {
  ABSENCE_CERTIFICATE
  EXAMS_PRESCRIPTION
  PRESCRIPTION
  OTHER
  CUSTOM_CERTIFICATE
}

enum BrazilConsentPaymentStatus {
  PENDING
  PAID
}

/// Mode an appointment is delivered in. The booking flow defaults to
/// ONLINE (the public site is a telemedicine platform); IN_PERSON is
/// supported for hybrid clinics where the doctor sees the patient
