{
    "name": "backend",
    "private": true,
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "postinstall": "prisma generate && node scripts/sync-docx-templates.mjs && node scripts/sync-alex-brush-font.mjs",
        "build": "tsc",
        "start": "prisma migrate deploy && node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test \"src/**/*.test.ts\"",
        "db:seed": "node --import tsx scripts/seed-test-accounts.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "generate:docs": "node --import tsx scripts/generate-test-documents.mjs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1043.0",
        "@fastify/autoload": "^6.3.1",
        "@fastify/compress": "^8.3.1",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/multipart": "^10.0.0",
        "@fastify/rate-limit": "^10.3.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@sendgrid/mail": "^8.1.6",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "fastify": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "luxon": "^3.5.0",
        "handlebars": "^4.7.8",
        "pizzip": "^3.2.0",
        "pdf-lib": "^1.17.1",
        "pg": "^8.20.0",
        "playwright": "^1.60.0",
        "sanitize-html": "^2.17.3",
        "stripe": "^22.1.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.4.2",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/sanitize-html": "^2.16.1",
        "prisma": "^7.8.0",
        "tsx": "^4.21.0",
        "typescript": "^5"
    }
}
