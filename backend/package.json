{
    "name": "backend",
    "private": true,
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "node --watch --import tsx src/server.ts",
        "postinstall": "prisma generate && node scripts/sync-docx-templates.mjs && node scripts/sync-alex-brush-font.mjs",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "test": "node --import tsx --import ./src/test-guard.ts --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
        "db:seed": "node --import tsx scripts/seed-test-accounts.ts",
        "db:seed:subscriptions": "node --import tsx scripts/seed-subscription-plans.ts",
        "sukl:check": "node --import tsx scripts/sukl-check.ts",
        "membership:ddl-check": "node --import tsx scripts/membership-ddl-check.ts",
        "db:generate": "prisma generate",
        "predb:migrate": "node scripts/guard-db-target.mjs migrate dev",
        "db:migrate": "prisma migrate dev",
        "predb:deploy": "node scripts/guard-db-target.mjs migrate deploy",
        "db:deploy": "prisma migrate deploy",
        "predb:studio": "node scripts/guard-db-target.mjs studio",
        "db:studio": "prisma studio",
        "generate:docs": "node --import tsx scripts/generate-test-documents.mjs",
        "test:automation": "node --import tsx scripts/test-automation-flow.ts",
        "test:db": "node --env-file=.env.test --import tsx --import ./src/test-guard.ts --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
        "test:db:setup": "docker compose -f ../docker-compose.yml up -d postgres-test && node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1107.0",
        "@fastify/autoload": "^6.5.0",
        "@fastify/compress": "^8.3.1",
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/rate-limit": "^10.3.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@sendgrid/mail": "^8.1.6",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "fastify": "^5.11.3",
        "handlebars": "^4.7.8",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.3",
        "luxon": "^3.5.0",
        "pdf-lib": "^1.17.1",
        "pg": "^8.23.0",
        "pizzip": "^3.2.0",
        "playwright": "^1.62.0",
        "qrcode": "^1.5.4",
        "sanitize-html": "^2.17.6",
        "sharp": "^0.35.3",
        "stripe": "^22.5.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.7.4",
        "@types/node": "^20",
        "@types/pg": "^8.21.0",
        "@types/qrcode": "^1.5.5",
        "@types/sanitize-html": "^2.16.1",
        "eslint": "^9",
        "prisma": "^7.9.1",
        "tsx": "^4.23.12",
        "typescript": "^5",
        "typescript-eslint": "^8.67.0"
    },
    "pnpm": {
        "//": "S-004: this service deploys standalone with --ignore-workspace and does NOT inherit the root package.json overrides. Mirror every security pin here by hand — when the root adds/bumps a CVE pin, add it here too or this build ships unpatched. Prefer major-scoped keys (e.g. ws@7) so a floor never becomes a ceiling.",
        "//auditConfig": "S-028: mirrors root package.json — see the note there. brace-expansion@1 bumped to the real 1.x fix (1.1.17); ignoreGhsas suppression dropped since the pin now actually patches it.",
        "overrides": {
            "sanitize-html": "^2.17.4",
            "hono": "4.12.25",
            "@hono/node-server": "1.19.13",
            "brace-expansion@1": "1.1.17",
            "brace-expansion@5": "5.0.8",
            "esbuild": "0.28.1",
            "ws@7": "7.5.11",
            "form-data": "4.0.6",
            "js-yaml": "4.3.0",
            "fast-uri": "3.1.4",
            "axios": "^1.18.1",
            "find-my-way": "^9.7.0",
            "sharp": "^0.35.3",
            "postcss": "8.5.23"
        }
    }
}
