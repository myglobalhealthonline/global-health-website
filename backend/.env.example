# Copy to backend/.env — never commit .env or paste real secrets into this file.
# Only empty placeholders belong here; rotate any credential that was ever pasted here.
#
# DATABASE (local dev): use the Postgres service PUBLIC TCP URL from Railway
# (DATABASE_PUBLIC_URL resolved), NOT postgres.railway.internal.
# Deployed backend should use: DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Example public URL:
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require"
# NOTE: never set NODE_TLS_REJECT_UNAUTHORIZED=0 — it disables TLS
# verification for the entire process (MITM risk). If the DB needs a
# custom CA, point at it with `sslrootcert=` in the connection string.

NODE_ENV=development
PORT=4000

DATABASE_URL=

# scripts/guard-db-target.mjs refuses schema- or data-mutating Prisma commands
# (migrate deploy/dev/reset/resolve, db push/execute/seed, studio) unless the
# host in DATABASE_URL is local or listed here. It runs from prisma.config.ts,
# so `npx prisma ...` is covered, not just the npm scripts.
#
# Put the host of THIS file's database here — then `--env-file=<this file>`
# needs no override, while backend/.env (production) still does. A one-off
# against a non-listed database has to name it:
#   DB_GUARD_ALLOW_HOST=<host> npx prisma migrate deploy
DB_GUARD_ALLOWED_HOSTS=

ADMIN_TOKEN_FALLBACK_ENABLED=false
AUTH_COOKIE_NAME=gh_admin_session

# Session-token signing (S-012 / SEC-004, asymmetric RS256 — the ONLY algorithm).
# The BACKEND holds the PRIVATE key and is the only party that can mint tokens;
# the frontend gets only the PUBLIC key (verify-only). REQUIRED in every
# environment now (dev included) — the HS256 shared-secret fallback was removed,
# so the backend cannot sign or verify sessions without this keypair.
# Generate a keypair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# Paste the PEM contents. A single-line var with literal "\n" for newlines works too
# (they are normalised back to real newlines).
AUTH_JWT_PRIVATE_KEY=   # backend ONLY — never set this on the frontend service
AUTH_JWT_PUBLIC_KEY=    # set on BOTH backend and frontend services
# @deprecated legacy HS256 secret. No longer used for auth sessions (RS256-only).
# Retained solely as the fallback HMAC key for Brazil consent-link tokens until
# BRAZIL_CONSENT_LINK_SECRET is set. Remove once that is configured everywhere.
AUTH_JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# S3-compatible storage (Scaleway, Railway bucket, etc.)
# Generated PDFs and uploads use keys under this bucket (e.g. generated/{doctorId}/…).
# Aliases accepted: S3_ACCESS_KEY → S3_ACCESS_KEY_ID, S3_SECRET_KEY → S3_SECRET_ACCESS_KEY
S3_BUCKET=patient-files
S3_ENDPOINT=https://s3.nl-ams.scw.cloud
S3_REGION=nl-ams
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Careers recruitment. ClamAV must be reachable over private networking;
# blank host means applications fail closed (job pages remain readable).
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
RECRUITMENT_NOTIFICATION_EMAIL=careers@myglobalhealth.online
# Must identify the localized recruitment notice approved and published for launch.
RECRUITMENT_PRIVACY_NOTICE_VERSION=recruitment-privacy-v1
RECRUITMENT_RETENTION_MONTHS=6
# Destructive purge remains disabled until privacy/legal approval and staging rehearsal.
RECRUITMENT_RETENTION_ENFORCE=false

# AWS Rekognition — face match between a patient's selfie and their ID photo
# (Ireland controlled-medication identity verification).
#
# NOT the S3_* credentials above: that bucket is S3-compatible storage with its
# own endpoint, while Rekognition is a real AWS service needing real AWS keys.
# Keep the region in the EU — the images are biometric-adjacent personal data.
#
# All optional. Leave blank and verification still works, as pure human review
# with no automated score to assist the reviewer. All three must be set for the
# automated check to run.
REKOGNITION_REGION=eu-west-1
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=
# Similarity % below which CompareFaces does not bother returning a match.
REKOGNITION_MIN_SIMILARITY=70

# Consultation PDFs (DOCX templates + LibreOffice on Railway via nixpacks)
# Optional: LIBREOFFICE_PATH=/usr/bin/soffice
# Optional: ALEX_BRUSH_FONT_PATH=/path/to/AlexBrush-Regular.ttf

# Stripe — DEFAULT (Ireland) account: used for every country except PT/ES/CZ,
# and for all subscription / Brazil-consent / redemption flows.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/booking/success
STRIPE_CANCEL_URL=http://localhost:3000/booking/cancel

# Per-country Stripe sandbox accounts (one-off consultation/order payments).
# Leave a pair blank to route that country to the Ireland account above.
# Webhook endpoint URL is the SAME for all accounts (/api/payments/webhook);
# each account has its own signing secret and the receiver tries them all.
# Spain (es/sp) uses the Ireland/default account above — no ES keys needed.
STRIPE_SECRET_KEY_PT=
STRIPE_WEBHOOK_SECRET_PT=
STRIPE_SECRET_KEY_CZ=
STRIPE_WEBHOOK_SECRET_CZ=

# Portugal InvoiceExpress — direct issuance of the legal InvoiceReceipt when a PT
# order is paid on the LIVE Stripe account (sk_live_ PT key). Both required to fire;
# leave blank to disable. ACCOUNT = subdomain, e.g. globalguestsro.
INVOICE_EXPRESS_API_KEY=
INVOICE_EXPRESS_ACCOUNT=

# Brazil consent
BRAZIL_BOOKING_URL=
BRAZIL_CONSENT_NOTIFY_EMAIL=
BRAZIL_CONSENT_DOCTOR_PHONE=

# Patient upload links (falls back to AUTH_JWT_SECRET)
PATIENT_UPLOAD_LINK_SECRET=

# OPTIONAL — application-layer encryption for PatientProfile government-ID
# fields (national/tax/passport). Unset = OFF (plaintext, current behaviour).
# When set, NEW writes are AES-256-GCM encrypted and reads transparently
# decrypt. After setting, run scripts/encrypt-phi-backfill.ts once to encrypt
# existing rows. WARNING: losing this key after enabling = losing those
# fields. Generate: openssl rand -base64 32
PHI_ENCRYPTION_KEY=

# Master compliance switch. strict (default) = today's behavior: production refuses to boot
# while the medical-access guard is in shadow mode. relaxed = shadow mode allowed in production
# (all access logged, nothing blocked); explicit MEDICAL_ACCESS_ENFORCE / ADMIN_PHI_REQUIRE_REASON always override.
COMPLIANCE_MODE=strict

# OPTIONAL — when true, plain ADMIN must supply a break-glass reason to read PHI (SUPER_ADMIN unaffected). Default false = unconditional ADMIN access.
ADMIN_PHI_REQUIRE_REASON=false

# EMERGENCY break-glass for AUDIT-STORE OUTAGES ONLY. Default false: while the guard is
# enforcing, a failed MedicalAccessLog write DENIES the PHI read (fail-closed, no PHI served
# without its audit row). Set true only during a confirmed audit-store outage to let reads
# proceed (the failure is logged loudly instead). Leave false in normal operation.
PHI_AUDIT_EMERGENCY_BYPASS=false

# WhatsApp WaSender (optional)
# WhatsApp (WaSender) — 6s minimum gap between sends (WASENDER_GAP_MS)
WA_API_URL=https://wasenderapi.com/api/send-message
WA_AUTH=Bearer YOUR_WASENDER_TOKEN
WASENDER_GAP_MS=6000
# Legacy alias (optional if WA_AUTH is set):
WASENDER_API_TOKEN=

# Review invites
REVIEW_FORM_WEBHOOK_SECRET=

# Email — SMTP is preferred; then Gmail; then SendGrid; else dev console log.
#
# SMTP (Migadu) is the only DMARC-aligned path for myglobalhealth.online: the
# apex SPF record is `v=spf1 include:spf.migadu.com -all` and key1/key2/key3
# ._domainkey publish Migadu's DKIM keys, so both align with the From domain.
# The Gmail API signs as <domain>.<date>.gappssmtp.com — authenticates but does
# NOT align, so every Gmail-sent automation email fails DMARC.
# SMTP_FROM must stay on the Migadu-hosted domain or alignment breaks again.
# Port 465 = implicit TLS; any other port requires STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Gmail send uses GOOGLE_OAUTH_CLIENT_ID/SECRET plus a dedicated refresh token (gmail.send scope).
# Calendar/Meet keeps GOOGLE_OAUTH_REFRESH_TOKEN; do not mix scopes on one token.
# Re-authorize send token via https://developers.google.com/oauthplayground (scope gmail.send)
GMAIL_SEND_FROM=
GMAIL_SEND_REFRESH_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM=

# Accounting archive (Dext): every PAID invoice/receipt for countries other than
# PT and CZ is forwarded there as a bare PDF — no subject copy, no body.
# Blank = the built-in Dext address in production, disabled outside production.
# Set an address to override (also how you test locally); set "off" to disable.
SALES_INVOICE_COPY_EMAIL=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Distinct passwords for the doctor/patient test accounts (seed-test-accounts).
# Both required and must differ; the script refuses to run otherwise.
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=

# REQUIRED in production. Shared secret for cron-triggered endpoints
# (abandoned-cart emails, appointment reminders). When unset, those
# endpoints fail CLOSED (503) and never run unauthenticated.
CRON_SECRET=

# Optional shared Redis store for the rate limiter (P-019). Unset = in-process
# store (fine on a single replica). Set when running multiple replicas so the
# limit is global across them. Example: redis://:password@host:6379
# REDIS_URL=

# Inbox that receives a duplicate of every automation email (defaults to globalhealth@myglobalhealth.online).
AUTOMATION_OFFICIAL_EMAIL=

# Staff booking alerts (order no., slot, doctor, consultation name; the patient
# name is withheld when the patient declined WhatsApp updates). Comma-separated.
# Unset -> that channel is skipped; the in-portal admin bell always fires.
ADMIN_NOTIFY_WHATSAPP_NUMBERS=
ADMIN_NOTIFY_EMAILS=
# WhatsApp group JID that mirrors the payment_confirmed alert (e.g. "1203...@g.us").
# Unset -> that group leg is skipped.
ADMIN_NOTIFY_WHATSAPP_GROUP_JID=

# Google OAuth client (shared by Calendar/Meet and Gmail send)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Calendar + Meet only (not used for Gmail when GMAIL_SEND_REFRESH_TOKEN is set)
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# SEO reporting (read-only GSC + GA4). The aliases below are accepted for this
# integration so they can remain separate from the Calendar/Meet credentials.
# GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/google/callback
# GOOGLE_GSC_SITE_URL=sc-domain:example.com
# GOOGLE_GA4_PROPERTY_ID=123456789  # numeric property ID, not the G- measurement ID
# GOOGLE_SEO_REFRESH_TOKEN=          # authorize webmasters.readonly + analytics.readonly

# --- SÚKL (Czech ePoukaz / eRecept) -----------------------------------------
# Authentication is mutual TLS with the WORKPLACE communication certificate
# issued to Global Guest s.r.o. — never a doctor's personal signing key.
# Every var is optional: leave them blank and the integration stays dark.
#
# NEVER commit the certificate or the password. NEVER set any of these on the
# frontend service, and never with a NEXT_PUBLIC_ prefix.
SUKL_ENVIRONMENT=test
# Local dev: absolute path to the test .pfx, OUTSIDE this repository.
#   e.g. C:\secure\sukl\sukl-test.pfx
SUKL_TEST_PFX_PATH=
# Railway: base64 of the same file (`base64 -w0 sukl-test.pfx`). Wins over PATH.
SUKL_TEST_PFX_BASE64=
SUKL_TEST_PFX_PASSWORD=
SUKL_TEST_WORKPLACE_CODE=
SUKL_TEST_ENTITY_ICO=
# ePoukaz test services. HOSTS ONLY — each operation's path comes from the
# soap:address in the current ePoukaz v19 WSDL. Two separate services, not one
# base URL with paths.
# eRecept (medicines) — the service the product needs.
SUKL_ERECEPT_CUER_TEST_URL=
# ePoukaz (medical devices only) — secondary.
SUKL_EPOUKAZ_CUEP_TEST_URL=
SUKL_EPOUKAZ_COMMON_TEST_URL=
# The cross-border pharmacist endpoint is intentionally absent — do not add it
# until SÚKL confirms the permitted cross-border workflow (SCOPE_CONFIRMATION Q7).
SUKL_REQUEST_TIMEOUT_MS=30000

# --- Google Drive invoice archive -------------------------------------------
# Paid fiscal documents (RECEIPT / INVOICE_RECEIPT) are filed to
# Invoice/<COUNTRY>/<YYYY-MM>/<date>_<number>.pdf as they are issued.
# OAuth refresh token, NOT a service account: the org enforces
# iam.disableServiceAccountKeyCreation. Mint it with
# `pnpm tsx scripts/mint-google-drive-token.ts` (scope .../auth/drive).
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional dedicated OAuth client; blank reuses GOOGLE_OAUTH_CLIENT_ID/SECRET.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_INVOICE_ROOT_FOLDER_ID=
# "on" = archive outside production too, "off" = disable everywhere.
# Unset means production only.
INVOICE_DRIVE_ARCHIVE=
