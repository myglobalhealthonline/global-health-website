{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:frontend"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:backend"
      ],
      "port": 4000
    },
    {
      "name": "backend-dev-db",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch",
        "--env-file=.env.dev",
        "--import",
        "tsx",
        "src/server.ts"
      ],
      "cwd": "backend",
      "port": 4000
    },
    {
      "name": "frontend-prod-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev"
      ],
      "cwd": "frontend",
      "env": {
        "NEXT_PUBLIC_API_URL": "https://api.myglobalhealth.online"
      },
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "frontend",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend-test-db",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env.test",
        "--import",
        "tsx",
        "src/server.ts"
      ],
      "cwd": "backend",
      "env": {
        "PORT": "4000",
        "NODE_ENV": "development",
        "PROXY_CLIENT_IP_SECRET": "local-loadprobe-secret-0123456789abcdef"
      },
      "port": 4000
    },
    {
      "name": "frontend-prod-build-prod-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3200"
      ],
      "cwd": "frontend",
      "env": {
        "NEXT_PUBLIC_API_URL": "https://api.myglobalhealth.online"
      },
      "port": 3200,
      "autoPort": true
    }
  ]
}
