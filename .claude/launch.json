{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:frontend"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:backend"
      ],
      "port": 4000
    },
    {
      "name": "frontend-prod-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "cwd": "frontend",
      "env": {
        "NEXT_PUBLIC_API_URL": "https://api.myglobalhealth.online"
      },
      "port": 3100
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "frontend",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
