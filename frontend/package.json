{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:locales": "node scripts/check-locale-keys.mjs",
    "audit:translations": "node scripts/audit-translations.mjs",
    "typecheck": "node scripts/check-locale-keys.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "flag-icons": "^7.5.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "chrome >= 91",
    "edge >= 91",
    "firefox >= 90",
    "safari >= 15",
    "ios_saf >= 15"
  ],
  "pnpm": {
    "//": "S-004: this service deploys standalone with --ignore-workspace and does NOT inherit the root package.json overrides. Mirror every security pin here by hand — when the root adds/bumps a CVE pin, add it here too or this build ships unpatched. Prefer major-scoped keys (e.g. ws@7) so a floor never becomes a ceiling.",
    "//auditConfig": "S-028: mirrors root package.json — see the note there. brace-expansion@1 bumped to the real 1.x fix (1.1.17); ignoreGhsas suppression dropped since the pin now actually patches it.",
    "overrides": {
      "sanitize-html": "^2.17.5",
      "postcss": "8.5.26",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "esbuild": "0.28.1",
      "vite": "8.0.16",
      "@babel/core": "7.29.6",
      "js-yaml": "4.3.1",
      "sharp": "^0.35.4",
      "nanoid": "3.3.18",
      "mysql2": "3.22.0",
      "browserslist@<=4.28.6": "4.28.7"
    }
  }
}
