# Railway (and other CI) set CI=true, which makes pnpm default to --frozen-lockfile.
# When this service uses Root Directory = `frontend`, the workspace pnpm-lock.yaml is not in the
# build context, so frozen install fails. This file applies only to installs rooted in `frontend/`.
frozen-lockfile=false

# S-028 (2026-08-02 Semgrep audit): wait 7 days before resolving a newly
# published package version, so a same-day-published malicious/typosquat
# release can't land in a build before it's had time to be caught/pulled.
min-release-age=7
